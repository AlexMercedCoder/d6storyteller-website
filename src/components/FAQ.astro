---
export interface FAQItem {
  question: string;
  answer: string;
}
export interface Props {
  items: FAQItem[];
  showAll?: boolean;
  maxItems?: number;
}
const { items, showAll = true, maxItems = items.length } = Astro.props;
const displayed = showAll ? items : items.slice(0, maxItems);
---
<div class="faq-list">
  {displayed.map((item, i) => (
    <details class="faq-item" data-index={i}>
      <summary class="faq-item__question" onclick={`try{if(window.gtag)gtag('event','faq_expand',{question_index:${i}});}catch(e){}`}>
        {item.question}
        <span class="faq-item__icon" aria-hidden="true">+</span>
      </summary>
      <div class="faq-item__answer">
        <p set:html={item.answer} />
      </div>
    </details>
  ))}
</div>

<style>
.faq-list { display: flex; flex-direction: column; gap: var(--space-3); }
.faq-item {
  background: var(--navy-900);
  border: 1px solid rgba(201,162,39,0.2);
  border-radius: var(--radius-md);
  overflow: hidden;
}
.faq-item[open] { border-color: rgba(201,162,39,0.5); }
.faq-item__question {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: var(--space-4);
  padding: var(--space-4) var(--space-6);
  font-family: var(--font-heading);
  font-size: var(--text-base);
  font-weight: 600;
  color: var(--gold-300);
  cursor: pointer;
  list-style: none;
  min-height: 44px;
}
.faq-item__question::-webkit-details-marker { display: none; }
.faq-item__question:hover { background: rgba(201,162,39,0.05); }
.faq-item__question:focus-visible { outline: 2px solid var(--gold-400); outline-offset: -2px; }
.faq-item__icon {
  font-size: var(--text-xl);
  color: var(--gold-400);
  transition: transform var(--transition-fast);
  flex-shrink: 0;
  line-height: 1;
}
.faq-item[open] .faq-item__icon { transform: rotate(45deg); }
.faq-item__answer {
  padding: 0 var(--space-6) var(--space-6);
  color: rgba(232,224,208,0.85);
  border-top: 1px solid rgba(201,162,39,0.1);
  padding-top: var(--space-4);
}
.faq-item__answer p { margin-bottom: var(--space-3); max-width: 68ch; }
.faq-item__answer p:last-child { margin-bottom: 0; }
</style>
