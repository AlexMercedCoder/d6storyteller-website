---
export interface Props {
  name: string;
  bookSlug: string;
  bookTitle: string;
  premise: string;
  mechanic?: string;
  tags: string[];
  link?: string;
  coverImage?: string;
  coverAlt?: string;
  type?: 'book' | 'supplement';
}
const { name, bookSlug, bookTitle, premise, mechanic, tags, link, coverImage, coverAlt, type = 'book' } = Astro.props;
const targetLink = link || `/books/${bookSlug}/`;
---
<article
  class="setting-card card"
  data-name={name.toLowerCase()}
  data-type={type}
  data-tags={tags.map(t => t.toLowerCase()).join(',')}
  data-search-text={`${name} ${premise} ${mechanic || ''} ${tags.join(' ')} ${bookTitle}`.toLowerCase()}
>
  {coverImage && (
    <div class="setting-card__image-wrap">
      <img src={coverImage} alt={coverAlt || name} width="300" height="180" loading="lazy" class="setting-card__cover" />
    </div>
  )}
  <header class="setting-card__header">
    <h3 class="setting-card__name">
      <a href={targetLink}>{name}</a>
    </h3>
    <a href={targetLink} class="setting-card__book-link">
      {type === 'supplement' ? '⚡ Online Supplement' : `From: ${bookTitle}`}
    </a>
  </header>
  <p class="setting-card__premise">{premise}</p>
  {mechanic && (
    <p class="setting-card__mechanic">
      <strong>Mechanic:</strong> {mechanic}
    </p>
  )}
  <div class="setting-card__tags">
    {tags.map(tag => <span class="tag tag--historical" style="font-size:0.65rem; cursor:pointer;" data-tag={tag.toLowerCase()}>{tag}</span>)}
  </div>
</article>

<style>
.setting-card { display: flex; flex-direction: column; gap: var(--space-3); overflow: hidden; }
.setting-card__image-wrap { width: 100%; aspect-ratio: 16 / 9; overflow: hidden; background: var(--navy-950); margin-bottom: var(--space-1); border-radius: var(--radius-sm); }
.setting-card__cover { width: 100%; height: 100%; object-fit: cover; transition: transform var(--transition-base); }
.setting-card:hover .setting-card__cover { transform: scale(1.04); }
.setting-card__header { display: flex; flex-direction: column; gap: var(--space-1); }
.setting-card__name { font-size: var(--text-lg); margin: 0; line-height: 1.2; }
.setting-card__name a { color: var(--gold-300); text-decoration: none; }
.setting-card__name a:hover { color: var(--gold-400); }
.setting-card__book-link { font-size: var(--text-xs); color: rgba(201,162,39,0.6); text-decoration: none; text-transform: uppercase; letter-spacing: 0.08em; font-family: var(--font-heading); }
.setting-card__book-link:hover { color: var(--gold-400); text-shadow: none; }
.setting-card__premise { font-size: var(--text-sm); color: rgba(232,224,208,0.8); margin: 0; line-height: 1.6; }
.setting-card__mechanic { font-size: var(--text-xs); color: rgba(232,224,208,0.6); margin: 0; }
.setting-card__mechanic strong { color: var(--gold-400); }
.setting-card__tags { display: flex; flex-wrap: wrap; gap: var(--space-1); margin-top: auto; }
</style>
