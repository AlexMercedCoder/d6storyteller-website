---
const AMAZON_URL = 'https://www.amazon.com/dp/B0HC4XMKW3?binding=paperback&ref_=saga_sdp_cft_dsk';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <!-- Brand -->
      <div class="site-footer__brand">
        <a href="/" class="site-footer__logo">
          <span aria-hidden="true">⚄</span> D6 Storyteller
        </a>
        <p class="site-footer__tagline">A fiction-first tabletop roleplaying engine by Alex Merced. Six-sided dice. Infinite stories.</p>
        <a
          href={AMAZON_URL}
          class="btn btn--primary site-footer__amazon"
          target="_blank"
          rel="noopener noreferrer"
          onclick="try{if(window.gtag)gtag('event','amazon_click',{book_slug:'series',placement:'footer',destination:'series_page'});}catch(e){}"
        >
          Explore on Amazon →
        </a>
      </div>

      <!-- Nav columns -->
      <nav class="site-footer__nav" aria-label="Footer navigation">
        <div class="site-footer__col">
          <h3 class="site-footer__col-heading">The Series</h3>
          <ul>
            <li><a href="/books/">All Books</a></li>
            <li><a href="/books/core-rulebook/">Core Rulebook</a></li>
            <li><a href="/get-started/">Get Started</a></li>
            <li><a href="/faq/">FAQ & About</a></li>
          </ul>
        </div>
        <div class="site-footer__col">
          <h3 class="site-footer__col-heading">Resources</h3>
          <ul>
            <li><a href="/settings/">Settings Directory</a></li>
            <li><a href="/supplements/">Online Supplements</a></li>
            <li><a href="/optional-mechanics/">Optional Mechanics</a></li>
            <li><a href="/prompts/">Prompts</a></li>
            <li><a href="/resources/dice-roller/">Dice Roller</a></li>
            <li><a href="/downloads/">Downloads</a></li>
            <li><a href="/community/">Community</a></li>
          </ul>
        </div>
        <div class="site-footer__col">
          <h3 class="site-footer__col-heading">About</h3>
          <ul>
            <li><a href="/faq/#about">About D6 Storyteller</a></li>
            <li><a href="https://WhoIsAlexMerced.com" target="_blank" rel="noopener noreferrer">About Alex Merced ↗</a></li>
            <li><a href="https://books.alexmerced.com" target="_blank" rel="noopener noreferrer">books.alexmerced.com ↗</a></li>
            <li><a href="/privacy/">Privacy Policy</a></li>
          </ul>
        </div>
      </nav>
    </div>

    <div class="site-footer__bottom">
      <p class="site-footer__legal">
        Copyright &copy; {year} Alex Merced. All rights reserved. D6 Storyteller is an original system by Alex Merced.
      </p>
      <p class="site-footer__disclaimer">
        Amazon links on this site lead to the D6 Storyteller series on Amazon. No affiliate relationship.
      </p>
    </div>
  </div>
</footer>

<style>
.site-footer {
  border-top: 1px solid rgba(201, 162, 39, 0.2);
  background: var(--navy-900);
  padding-block: var(--space-16) var(--space-8);
  margin-top: var(--space-20);
  position: relative;
  z-index: 1;
}

.site-footer__grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-10);
  margin-bottom: var(--space-12);
}

@media (min-width: 768px) {
  .site-footer__grid { grid-template-columns: 1.5fr 2fr; }
}

.site-footer__logo {
  font-family: var(--font-display);
  font-size: var(--text-xl);
  color: var(--gold-300);
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  margin-bottom: var(--space-3);
}

.site-footer__tagline {
  font-size: var(--text-sm);
  color: rgba(232, 224, 208, 0.5);
  line-height: 1.6;
  margin-bottom: var(--space-6);
  max-width: 36ch;
}

.site-footer__amazon { display: inline-flex; font-size: 0.8rem; }

.site-footer__nav {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-6);
}

@media (max-width: 640px) {
  .site-footer__nav { grid-template-columns: 1fr 1fr; }
}

.site-footer__col-heading {
  font-size: var(--text-xs);
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--gold-400);
  margin-bottom: var(--space-4);
  font-family: var(--font-heading);
}

.site-footer__col ul {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.site-footer__col a {
  font-size: var(--text-sm);
  color: rgba(232, 224, 208, 0.55);
  text-decoration: none;
  transition: color var(--transition-fast);
}

.site-footer__col a:hover {
  color: var(--gold-300);
  text-shadow: none;
}

.site-footer__bottom {
  border-top: 1px solid rgba(255,255,255,0.05);
  padding-top: var(--space-6);
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.site-footer__legal,
.site-footer__disclaimer {
  font-size: var(--text-xs);
  color: rgba(232, 224, 208, 0.35);
  margin: 0;
  max-width: 100%;
}
</style>
