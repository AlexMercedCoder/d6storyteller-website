---
const AMAZON_URL = 'https://www.amazon.com/dp/B0HC4XMKW3?binding=paperback&ref_=saga_sdp_cft_dsk';
const year = new Date().getFullYear();

// Network links and the CTA come from network/network.json, regenerated by
// alexmercedcom/scripts/build-network-shared.mjs. Do not hard-code them here.
import network from '../../network/network.json';
const { footer, cta } = network;
---

{cta && (
  <section class="network-cta" aria-label={cta.heading}>
    <div class="container network-cta__inner">
      <h2 class="network-cta__heading">{cta.heading}</h2>
      <div class="network-cta__links">
        {cta.links.map((l, i) => (
          <a href={l.url} class={i === 0 ? 'btn btn--primary' : 'btn btn--secondary'} data-network-event={l.event} target="_blank" rel="noopener noreferrer">{l.label}</a>
        ))}
      </div>
    </div>
  </section>
)}

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <!-- Brand -->
      <div class="site-footer__brand">
        <a href="/" class="site-footer__logo">
          <span aria-hidden="true">⚄</span> D6 Storyteller
        </a>
        <p class="site-footer__tagline">A fiction-first tabletop roleplaying engine by Alex Merced. Six-sided dice. Infinite stories.</p>
        <a
          href={AMAZON_URL}
          class="btn btn--primary site-footer__amazon"
          target="_blank"
          rel="noopener noreferrer"
          onclick="try{if(window.gtag)gtag('event','amazon_click',{book_slug:'series',placement:'footer',destination:'series_page'});}catch(e){}"
        >
          Explore on Amazon →
        </a>
      </div>

      <!-- Nav columns -->
      <nav class="site-footer__nav" aria-label="Footer navigation">
        <div class="site-footer__col">
          <h3 class="site-footer__col-heading">The Series</h3>
          <ul>
            <li><a href="/books/">All Books</a></li>
            <li><a href="/books/core-rulebook/">Core Rulebook</a></li>
            <li><a href="/get-started/">Get Started</a></li>
            <li><a href="/faq/">FAQ & About</a></li>
          </ul>
        </div>
        <div class="site-footer__col">
          <h3 class="site-footer__col-heading">Resources</h3>
          <ul>
            <li><a href="/settings/">Settings Directory</a></li>
            <li><a href="/optional-mechanics/">Optional Mechanics</a></li>
            <li><a href="/prompts/">Prompts</a></li>
            <li><a href="/resources/dice-roller/">Dice Roller</a></li>
            <li><a href="/downloads/">Downloads</a></li>
            <li><a href="/community/">Community</a></li>
          </ul>
        </div>
        <div class="site-footer__col">
          <h3 class="site-footer__col-heading">About</h3>
          <ul>
            <li><a href="/faq/#about">About D6 Storyteller</a></li>
            <li><a href="https://whoisalexmerced.com" target="_blank" rel="noopener noreferrer">About Alex Merced ↗</a></li>
            <li><a href="https://books.alexmerced.com" target="_blank" rel="noopener noreferrer">books.alexmerced.com ↗</a></li>
            <li><a href="/privacy/">Privacy Policy</a></li>
          </ul>
        </div>
      </nav>
    </div>

    {footer.groups.map((group) => (
      <nav class="site-footer__network" aria-label={group.title}>
        <h3 class="site-footer__col-heading">{group.title}</h3>
        <ul>
          {group.links.map((site) => (
            <li><a href={site.url} target="_blank" rel="noopener noreferrer">{site.title}</a></li>
          ))}
          <li><a href={footer.allSitesUrl} target="_blank" rel="noopener noreferrer">{footer.allSitesLabel}</a></li>
        </ul>
      </nav>
    ))}

    <div class="site-footer__bottom">
      <p class="site-footer__legal">
        Copyright &copy; {year} Alex Merced. All rights reserved. D6 Storyteller is an original system by Alex Merced.
      </p>
      <p class="site-footer__disclaimer">
        Amazon links on this site lead to the D6 Storyteller series on Amazon. No affiliate relationship.
      </p>
    </div>
  </div>
</footer>

<style>
.network-cta {
  border-top: 1px solid rgba(201, 162, 39, 0.2);
  padding-block: var(--space-10);
  margin-top: var(--space-20);
  position: relative;
  z-index: 1;
}
.network-cta__inner {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-4) var(--space-8);
}
.network-cta__heading {
  font-family: var(--font-display);
  color: var(--gold-300);
  font-size: var(--text-2xl);
  margin: 0;
}
.network-cta__links { display: flex; flex-wrap: wrap; gap: var(--space-3); }
.network-cta + .site-footer { margin-top: 0; }

.site-footer {
  border-top: 1px solid rgba(201, 162, 39, 0.2);
  background: var(--navy-900);
  padding-block: var(--space-16) var(--space-8);
  margin-top: var(--space-20);
  position: relative;
  z-index: 1;
}

.site-footer__grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-10);
  margin-bottom: var(--space-12);
}

@media (min-width: 768px) {
  .site-footer__grid { grid-template-columns: 1.5fr 2fr; }
}

.site-footer__logo {
  font-family: var(--font-display);
  font-size: var(--text-xl);
  color: var(--gold-300);
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  margin-bottom: var(--space-3);
}

.site-footer__tagline {
  font-size: var(--text-sm);
  color: rgba(232, 224, 208, 0.5);
  line-height: 1.6;
  margin-bottom: var(--space-6);
  max-width: 36ch;
}

.site-footer__amazon { display: inline-flex; font-size: 0.8rem; }

.site-footer__nav {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-6);
}

@media (max-width: 640px) {
  .site-footer__nav { grid-template-columns: 1fr 1fr; }
}

.site-footer__col-heading {
  font-size: var(--text-xs);
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--gold-400);
  margin-bottom: var(--space-4);
  font-family: var(--font-heading);
}

.site-footer__col ul {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.site-footer__col a {
  font-size: var(--text-sm);
  color: rgba(232, 224, 208, 0.55);
  text-decoration: none;
  transition: color var(--transition-fast);
}

.site-footer__col a:hover {
  color: var(--gold-300);
  text-shadow: none;
}

.site-footer__network {
  border-top: 1px solid rgba(255,255,255,0.05);
  padding-block: var(--space-6);
}

.site-footer__network ul {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2) var(--space-4);
}

.site-footer__network a {
  font-size: var(--text-sm);
  color: rgba(232, 224, 208, 0.55);
  text-decoration: none;
  transition: color var(--transition-fast);
}

.site-footer__network a:hover {
  color: var(--gold-300);
  text-shadow: none;
}

.site-footer__bottom {
  border-top: 1px solid rgba(255,255,255,0.05);
  padding-top: var(--space-6);
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.site-footer__legal,
.site-footer__disclaimer {
  font-size: var(--text-xs);
  color: rgba(232, 224, 208, 0.35);
  margin: 0;
  max-width: 100%;
}
</style>
