---
import SEOHead from '../components/SEOHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StructuredData from '../components/StructuredData.astro';
// Shared network head (GA4, click events, canonical Person JSON-LD), generated by
// alexmercedcom/scripts/build-network-shared.mjs. Do not copy its contents here.
import networkHead from '../../network/network-head.html?raw';

export interface Props {
  title: string;
  description: string;
  canonicalUrl: string;
  ogImage?: string;
  ogType?: string;
  noIndex?: boolean;
  jsonLd?: object | object[];
}

const {
  title,
  description,
  canonicalUrl,
  ogImage = '/images/social/d6-storyteller-home.jpg',
  ogType = 'website',
  noIndex = false,
  jsonLd,
} = Astro.props;

// Page templates reference these by @id (isPartOf, author, publisher). The Person
// (https://alexmerced.com/#alexmerced) comes from the network head on every page.
const SITE_URL = 'https://d6storyteller.alexmerced.com';
const siteEntities = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#website`,
      url: `${SITE_URL}/`,
      name: 'D6 Storyteller',
      description:
        'A fiction-first tabletop roleplaying system and book series by Alex Merced.',
      inLanguage: 'en-US',
      publisher: { '@id': 'https://alexmerced.com/#alexmerced' },
    }
  ],
};
---

<!DOCTYPE html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEOHead
      title={title}
      description={description}
      canonicalUrl={canonicalUrl}
      ogImage={ogImage}
      ogType={ogType}
      noIndex={noIndex}
    />
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#07111f" />
    <Fragment set:html={networkHead} />
    <!-- Site entities, emitted on every page so page-level @id references resolve -->
    <StructuredData data={siteEntities} />
    {jsonLd && <StructuredData data={jsonLd} />}
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <!-- WebMCP: read-only tools for browser AI agents. Progressive enhancement;
       no effect where WebMCP is unsupported. Config in /webmcp/init.js -->
  <script src="/webmcp/alex-merced-webmcp.js" defer></script>
  <script src="/webmcp/init.js" defer></script>
</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
