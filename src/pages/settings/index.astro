---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SettingCard from '../../components/SettingCard.astro';
import { getCollection } from 'astro:content';

const books = (await getCollection('books')).sort((a, b) => a.data.order - b.data.order);
const supplements = await getCollection('community-settings');

// 1. Flatten all book settings
const bookSettings = books.flatMap(book =>
  book.data.settings.map(setting => ({
    name: setting.name,
    bookSlug: book.slug,
    bookTitle: book.data.shortTitle,
    premise: setting.premise,
    mechanic: setting.mechanic,
    tags: setting.tags,
    type: 'book' as const,
    link: `/books/${book.slug}/`,
  }))
);

// 2. Map all supplemental settings
const suppSettings = supplements.map(supp => ({
  name: supp.data.title,
  bookSlug: supp.slug,
  bookTitle: 'Online Supplement',
  premise: supp.data.premise,
  mechanic: supp.data.mechanic,
  tags: [supp.data.genre, ...supp.data.tags],
  type: 'supplement' as const,
  link: `/community-settings/${supp.slug}/`,
  coverImage: supp.data.coverImage,
  coverAlt: supp.data.coverAlt,
}));

// Combine all settings
const allSettings = [...suppSettings, ...bookSettings];
const allTags = [...new Set(allSettings.flatMap(s => s.tags))].sort();

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": "https://d6storyteller.alexmerced.com/settings/#webpage",
  "url": "https://d6storyteller.alexmerced.com/settings/",
  "name": "Settings Directory | D6 Storyteller World Index",
  "description": "All settings across the D6 Storyteller universe: core book worlds plus supplemental settings.",
  "isPartOf": { "@id": "https://d6storyteller.alexmerced.com/#website" },
  "about": { "@id": "https://d6storyteller.alexmerced.com/#series" },
  "inLanguage": "en-US"
};
---

<BaseLayout
  title="Settings Directory | D6 Storyteller World Index"
  description="Explore all settings across the D6 Storyteller universe: core book worlds plus online supplemental settings with custom artwork and unique mechanics. Filter by tag, genre, or keyword."
  canonicalUrl="https://d6storyteller.alexmerced.com/settings/"
  jsonLd={jsonLd}
>
  <section class="section" aria-labelledby="settings-heading">
    <div class="container">
      <nav aria-label="Breadcrumb" class="breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__separator" aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Settings Directory</span>
      </nav>

      <p class="section-label">Master World Library</p>
      <h1 id="settings-heading">Settings Directory ({allSettings.length} Worlds)</h1>
      <p class="settings-intro">
        Browse the complete D6 Storyteller setting catalog: <strong>100 worlds from the core book series</strong> plus <strong>{suppSettings.length} online supplemental settings</strong> featuring custom artwork and unique genre mechanics. Use the search bar or tag filters to find worlds by name, theme, or mechanic.
      </p>

      <!-- Category Filter Tabs -->
      <div class="setting-type-tabs" id="setting-type-tabs">
        <button type="button" class="type-tab type-tab--active" data-type-filter="">All Worlds ({allSettings.length})</button>
        <button type="button" class="type-tab" data-type-filter="book">Book Series ({bookSettings.length})</button>
        <button type="button" class="type-tab" data-type-filter="supplement">Online Supplements ({suppSettings.length})</button>
      </div>

      <!-- Filter Controls Box -->
      <div class="filter-controls card">
        <div class="filter-controls__inputs">
          <div class="filter-controls__field filter-controls__field--search">
            <label for="setting-search" class="filter-label">Search Settings</label>
            <div class="search-input-wrap">
              <span class="search-icon" aria-hidden="true">🔍</span>
              <input
                type="text"
                id="setting-search"
                class="filter-input"
                placeholder="Search by world name, premise, country, or mechanic..."
                aria-label="Search settings by name, premise, or mechanic"
              />
              <button type="button" id="clear-search" class="clear-btn hidden" aria-label="Clear search">✕</button>
            </div>
          </div>

          <div class="filter-controls__field filter-controls__field--select">
            <label for="tag-select" class="filter-label">Filter by Tag</label>
            <select id="tag-select" class="filter-select" aria-label="Filter by tag">
              <option value="">All Tags ({allTags.length})</option>
              {allTags.map(tag => (
                <option value={tag.toLowerCase()}>{tag}</option>
              ))}
            </select>
          </div>
        </div>

        <!-- Tag Quick Pills -->
        <div class="tag-pills" id="tag-pills">
          <span class="tag-pills__label">Popular Tags:</span>
          <button type="button" class="tag-pill tag-pill--active" data-tag="">All</button>
          {allTags.slice(0, 20).map(tag => (
            <button type="button" class="tag-pill" data-tag={tag.toLowerCase()}>{tag}</button>
          ))}
        </div>

        <div class="filter-summary">
          <span id="results-count" class="results-count">Showing {allSettings.length} of {allSettings.length} worlds</span>
          <button type="button" id="reset-filters" class="btn btn--secondary btn--sm reset-btn hidden">Reset Filters</button>
        </div>
      </div>

      <!-- Settings Grid -->
      <div class="settings-grid" id="settings-grid">
        {allSettings.map(setting => (
          <SettingCard
            name={setting.name}
            bookSlug={setting.bookSlug}
            bookTitle={setting.bookTitle}
            premise={setting.premise}
            mechanic={setting.mechanic}
            tags={setting.tags}
            link={setting.link}
            coverImage={setting.coverImage}
            coverAlt={setting.coverAlt}
            type={setting.type}
          />
        ))}
      </div>

      <!-- Empty State -->
      <div id="no-results" class="no-results card hidden">
        <div class="no-results__icon" aria-hidden="true">📜</div>
        <h3>No Settings Found</h3>
        <p>No setting matches your search term or tag filter. Try adjusting your search query or reset your filters.</p>
        <button type="button" id="no-results-reset" class="btn btn--primary">Show All {allSettings.length} Worlds</button>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('setting-search') as HTMLInputElement | null;
    const tagSelect = document.getElementById('tag-select') as HTMLSelectElement | null;
    const clearSearchBtn = document.getElementById('clear-search') as HTMLButtonElement | null;
    const resetFiltersBtn = document.getElementById('reset-filters') as HTMLButtonElement | null;
    const noResultsResetBtn = document.getElementById('no-results-reset') as HTMLButtonElement | null;
    const resultsCount = document.getElementById('results-count');
    const noResults = document.getElementById('no-results');
    const settingsGrid = document.getElementById('settings-grid');
    const tagPillsContainer = document.getElementById('tag-pills');
    const typeTabsContainer = document.getElementById('setting-type-tabs');

    if (!settingsGrid) return;

    const cards = Array.from(settingsGrid.querySelectorAll('.setting-card')) as HTMLElement[];
    const totalCount = cards.length;

    let currentQuery = '';
    let currentTag = '';
    let currentType = '';

    function filterSettings() {
      let visibleCount = 0;

      cards.forEach(card => {
        const searchText = card.getAttribute('data-search-text') || '';
        const cardTags = (card.getAttribute('data-tags') || '').split(',');
        const cardType = card.getAttribute('data-type') || '';

        const matchesQuery = !currentQuery || searchText.includes(currentQuery.toLowerCase().trim());
        const matchesTag = !currentTag || cardTags.includes(currentTag.toLowerCase());
        const matchesType = !currentType || cardType === currentType;

        if (matchesQuery && matchesTag && matchesType) {
          card.style.display = '';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (resultsCount) {
        resultsCount.textContent = `Showing ${visibleCount} of ${totalCount} worlds`;
      }

      if (noResults) {
        if (visibleCount === 0) {
          noResults.classList.remove('hidden');
          settingsGrid.style.display = 'none';
        } else {
          noResults.classList.add('hidden');
          settingsGrid.style.display = 'grid';
        }
      }

      if (clearSearchBtn) {
        if (currentQuery) {
          clearSearchBtn.classList.remove('hidden');
        } else {
          clearSearchBtn.classList.add('hidden');
        }
      }

      if (resetFiltersBtn) {
        if (currentQuery || currentTag || currentType) {
          resetFiltersBtn.classList.remove('hidden');
        } else {
          resetFiltersBtn.classList.add('hidden');
        }
      }

      if (tagPillsContainer) {
        const pills = tagPillsContainer.querySelectorAll('.tag-pill');
        pills.forEach(pill => {
          const pillTag = pill.getAttribute('data-tag') || '';
          if (pillTag === currentTag) {
            pill.classList.add('tag-pill--active');
          } else {
            pill.classList.remove('tag-pill--active');
          }
        });
      }

      if (typeTabsContainer) {
        const tabs = typeTabsContainer.querySelectorAll('.type-tab');
        tabs.forEach(tab => {
          const tabType = tab.getAttribute('data-type-filter') || '';
          if (tabType === currentType) {
            tab.classList.add('type-tab--active');
          } else {
            tab.classList.remove('type-tab--active');
          }
        });
      }

      if (tagSelect && tagSelect.value !== currentTag) {
        tagSelect.value = currentTag;
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        currentQuery = (e.target as HTMLInputElement).value;
        filterSettings();
      });
    }

    if (tagSelect) {
      tagSelect.addEventListener('change', (e) => {
        currentTag = (e.target as HTMLSelectElement).value;
        filterSettings();
      });
    }

    if (tagPillsContainer) {
      tagPillsContainer.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target.classList.contains('tag-pill')) {
          currentTag = target.getAttribute('data-tag') || '';
          filterSettings();
        }
      });
    }

    if (typeTabsContainer) {
      typeTabsContainer.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target.classList.contains('type-tab')) {
          currentType = target.getAttribute('data-type-filter') || '';
          filterSettings();
        }
      });
    }

    settingsGrid.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.hasAttribute('data-tag')) {
        const tag = target.getAttribute('data-tag') || '';
        currentTag = tag;
        filterSettings();
      }
    });

    if (clearSearchBtn) {
      clearSearchBtn.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        currentQuery = '';
        filterSettings();
        if (searchInput) searchInput.focus();
      });
    }

    function resetAll() {
      if (searchInput) searchInput.value = '';
      currentQuery = '';
      currentTag = '';
      currentType = '';
      if (tagSelect) tagSelect.value = '';
      filterSettings();
    }

    if (resetFiltersBtn) resetFiltersBtn.addEventListener('click', resetAll);
    if (noResultsResetBtn) noResultsResetBtn.addEventListener('click', resetAll);
  });
</script>

<style>
.settings-intro {
  max-width: 70ch;
  font-size: var(--text-lg);
  color: rgba(232, 224, 208, 0.85);
  margin-bottom: var(--space-6);
  line-height: 1.6;
}

/* Category Tabs */
.setting-type-tabs {
  display: flex;
  gap: var(--space-3);
  margin-bottom: var(--space-6);
  flex-wrap: wrap;
}

.type-tab {
  font-family: var(--font-heading);
  font-size: var(--text-sm);
  font-weight: 600;
  color: rgba(232, 224, 208, 0.7);
  background: var(--navy-900);
  border: 1px solid rgba(201, 162, 39, 0.2);
  border-radius: var(--radius-md);
  padding: var(--space-3) var(--space-5);
  cursor: pointer;
  transition: all var(--transition-fast);
}

.type-tab:hover {
  color: var(--gold-300);
  border-color: var(--gold-400);
  background: rgba(201, 162, 39, 0.1);
}

.type-tab--active {
  color: var(--navy-950);
  background: var(--gold-400);
  border-color: var(--gold-300);
  font-weight: 700;
}

.settings-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: var(--space-6);
}
</style>
