---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQ from '../components/FAQ.astro';
import { getCollection } from 'astro:content';

const books = (await getCollection('books')).sort((a, b) => a.data.order - b.data.order);
const AMAZON_URL = 'https://www.amazon.com/dp/B0HC4XMKW3?binding=paperback&ref_=saga_sdp_cft_dsk';

const steps = [
  {
    number: '01',
    title: 'Describe the Scene',
    body: 'Before any dice touch the table, the group establishes what is happening in the fiction. Where is your character? What are they attempting? What could go wrong, and what does success look like? Narrative context establishes the stakes.',
  },
  {
    number: '02',
    title: 'Determine Position and Effect',
    body: 'Position describes how vulnerable your character is if things go wrong: Controlled (upper hand), Risky (standard stakes), or Desperate (real danger). Effect describes how much you can achieve: Limited, Standard, or Great. Position and effect are set through story context, not arithmetic.',
  },
  {
    number: '03',
    title: 'Choose Your Approach',
    body: 'Your character has four core approaches: Force (direct physical action), Finesse (precise, quick, or subtle action), Mind (analysis, planning, knowledge), and Presence (social influence, leadership). Choose the one that matches how your character acts in the fiction.',
  },
  {
    number: '04',
    title: 'Assemble Your Dice Pool',
    body: 'Start with your approach dice (rated 1d6 to 4d6). You can modify your pool: teamwork assistance adds dice, advantage or tools add dice, or you can spend 1 Momentum from your group pool to add a die or upgrade position/effect.',
  },
  {
    number: '05',
    title: 'Roll and Read the Highest Die',
    body: 'Roll your assembled pool and read the single highest die face: 6 = Full Success (multiple 6s = Great Effect); 4–5 = Partial Success (you succeed, but with a complication or cost); 1–3 = Failure (the action fails and a consequence follows). No math modifiers are added.',
  },
  {
    number: '06',
    title: 'Narrate the Outcome',
    body: 'The roll tells you the outcome tier. The table fills in the fiction. On a Full Success, describe how you pulled it off. On a Partial, the Storyteller introduces the cost and you respond. On a Failure, the consequence strikes, and the story continues without stopping.',
  },
];

const faqItems = [
  {
    question: 'What does "fiction first" mean?',
    answer: 'Fiction first means that the narrative situation establishes the context before any dice are rolled. Your character\'s position (whether you\'re cornered, advantaged, under pressure, or operating with incomplete information) determines how many dice you roll and how much effect your action can have. The dice confirm the story; the fiction drives it.',
  },
  {
    question: 'How does the D6 dice pool work?',
    answer: 'You assemble a pool of six-sided dice based on your character\'s relevant approach and narrative position. Roll the pool and read the highest single die: 6 is a full success, 4–5 is a partial success with complication, 1–3 is a failure (though the story still moves forward). Multiple 6s can elevate the effect of a success.',
  },
  {
    question: 'Is D6 Storyteller beginner friendly?',
    answer: 'Yes. The system uses only standard six-sided dice you likely already own, has no complex lookup tables, and can put a new group at the table in under 15 minutes. The Core Rulebook includes a Storyteller\'s guide written specifically for people facilitating their first session.',
  },
  {
    question: 'What dice does D6 Storyteller use?',
    answer: 'Only standard six-sided dice (d6). No proprietary or unusual dice are required. Most households have several already.',
  },
  {
    question: 'Can settings from different books be combined?',
    answer: 'Yes. The D6 Storyteller engine is intentionally modular. Setting-specific mechanics from any companion can be imported into other worlds, and groups can mix lore and setting elements across books freely.',
  },
];

const whyD6 = [
  {
    icon: '🎲',
    title: 'Any Six-Sided Dice',
    body: 'No proprietary or unusual dice required. Just standard d6s: the kind found in almost every board game ever made.',
  },
  {
    icon: '📖',
    title: 'Fiction First',
    body: 'Narrative position drives every roll. Your character\'s story situation, not a list of modifiers, determines the stakes.',
  },
  {
    icon: '⚡',
    title: 'Ready in Minutes',
    body: 'Character creation takes under 15 minutes. Every companion book includes three ready-to-play archetypes. Start playing immediately.',
  },
  {
    icon: '🌍',
    title: 'One Hundred Worlds',
    body: 'Ten books. Ten settings each. Fantasy, sci-fi, horror, historical, superheroes, post-apocalyptic, and more: all using the same engine.',
  },
  {
    icon: '⚙️',
    title: 'Modular by Design',
    body: 'Every setting mechanic is optional. Mix and match lore and rules across companion books. The engine adapts to any premise.',
  },
  {
    icon: '🔓',
    title: 'Genuinely Accessible',
    body: 'D6 Storyteller was designed for people who love stories and may not love complicated rule systems. Low barriers to the table.',
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://d6storyteller.alexmerced.com/get-started/#webpage",
  "url": "https://d6storyteller.alexmerced.com/get-started/",
  "name": "Get Started & How It Works | D6 Storyteller Guide",
  "description": "Learn how the D6 Storyteller engine works: fiction-first positioning, dice pool assembly, sample game walkthrough, character creation, and core rules.",
  "isPartOf": { "@id": "https://d6storyteller.alexmerced.com/#website" }
};
---

<BaseLayout
  title="Get Started & How It Works | D6 Storyteller Tabletop RPG"
  description="Learn how D6 Storyteller works: fiction-first narrative positioning, D6 dice pools, sample game walkthrough, position and effect, characters, and getting started in 15 minutes."
  canonicalUrl="https://d6storyteller.alexmerced.com/get-started/"
  jsonLd={jsonLd}
>

  <!-- Hero -->
  <section class="section gs-hero" aria-labelledby="get-started-heading">
    <div class="container container--narrow">
      <nav aria-label="Breadcrumb" class="breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__separator" aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Get Started & How It Works</span>
      </nav>

      <p class="section-label">System Overview & Quickstart</p>
      <h1 id="get-started-heading" class="gs-hero__title">Get Started & How It Works</h1>
      <p class="gs-hero__lead">
        D6 Storyteller is a fiction-first tabletop roleplaying engine. It resolves uncertain actions using pools of standard six-sided dice, puts narrative context before mechanics, and gets any group playing in under fifteen minutes.
      </p>
    </div>
  </section>

  <!-- How to Play explainer video -->
  <section class="section section--tight gs-video" aria-labelledby="video-heading">
    <div class="container container--narrow">
      <p class="section-label">Watch First</p>
      <h2 id="video-heading">How to Play in 60 Seconds</h2>
      <p class="gs-video__intro">
        The entire core loop, animated: describe your character with Approaches, let the Storyteller set your Position and Effect, build a pool of six-sided dice, and read the single highest die. No sound needed.
      </p>
      <figure class="gs-video__figure">
        <video
          class="gs-video__player"
          controls
          preload="metadata"
          playsinline
          width="1920"
          height="1080"
          poster="/images/how-to-play-poster.jpg"
          aria-describedby="video-caption"
        >
          <source src="/videos/how-to-play.mp4" type="video/mp4" />
          <p class="gs-video__fallback">
            Your browser can&rsquo;t play this video.
            <a href="/videos/how-to-play.mp4">Download the How to Play video (MP4)</a> instead.
          </p>
        </video>
        <figcaption id="video-caption" class="gs-video__caption">
          <strong>How to Play D6 Storyteller.</strong> Roll a pool of d6 and read the single highest die: a <span class="gs-video__tier gs-video__tier--success">6 is a Full Success</span> (multiple 6s grant Great Effect), a <span class="gs-video__tier gs-video__tier--partial">4&ndash;5 is a Partial Success</span> with a cost, and a <span class="gs-video__tier gs-video__tier--fail">1&ndash;3 is a Failure</span> that still moves the story forward. Spend Momentum to push (+1d6). Silent, ~53-second animation.
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- What you need -->
  <section class="section section--tight gs-needs" aria-labelledby="needs-heading">
    <div class="container container--narrow">
      <h2 id="needs-heading">What You Need to Start</h2>
      <div class="gs-needs__grid">
        <div class="gs-needs__item">
          <span class="gs-needs__icon" aria-hidden="true">📗</span>
          <div>
            <strong>The Core Rulebook</strong>
            <p>Contains the complete rules engine plus ten starter worlds. Everything a group needs in one book.</p>
          </div>
        </div>
        <div class="gs-needs__item">
          <span class="gs-needs__icon" aria-hidden="true">🎲</span>
          <div>
            <strong>Standard Six-Sided Dice</strong>
            <p>Four to six d6 per player is ideal. Check your board game shelf: standard d6s are all you need.</p>
          </div>
        </div>
        <div class="gs-needs__item">
          <span class="gs-needs__icon" aria-hidden="true">📄</span>
          <div>
            <strong>Paper and a Pencil</strong>
            <p>For character notes. Index cards work great. No proprietary character sheet required to begin.</p>
          </div>
        </div>
        <div class="gs-needs__item">
          <span class="gs-needs__icon" aria-hidden="true">🪑</span>
          <div>
            <strong>A Group and 15 Minutes</strong>
            <p>Pick a setting from the Core Rulebook, choose or build your characters, and frame your first scene.</p>
          </div>
        </div>
      </div>
      <div class="gs-needs__cta">
        <a href={AMAZON_URL} class="btn btn--primary" target="_blank" rel="noopener noreferrer" onclick="try{if(window.gtag)gtag('event','amazon_click',{book_slug:'core-rulebook',placement:'get_started_needs',destination:'book_page'});}catch(e){}">
          Get the Core Rulebook on Amazon →
        </a>
      </div>
    </div>
  </section>

  <!-- Fiction First Explanation -->
  <section class="section gs-fiction-first" aria-labelledby="ff-heading">
    <div class="container container--narrow">
      <p class="section-label">The Core Philosophy</p>
      <h2 id="ff-heading">What Does "Fiction First" Mean?</h2>
      <p>
        In traditional tabletop RPGs, players pick an action from a menu of skills or spells and add numeric modifiers. D6 Storyteller inverts this approach:
      </p>
      <div class="gs-callout">
        <p>
          <strong>First establish the fiction:</strong> Where is your character? What are they attempting? Are they holding the high ground or cornered in a burning corridor? What tools or preparation do they have?
        </p>
        <p>
          <strong>Then set the mechanics:</strong> That fictional reality dictates your <em>approach</em>, your <em>position</em> (how risky it is), and your <em>effect</em> (how much you achieve). The dice confirm what happens; the story drives the roll.
        </p>
      </div>
    </div>
  </section>

  <!-- The 6-step core loop -->
  <section class="section gs-loop" aria-labelledby="loop-heading">
    <div class="container container--narrow">
      <p class="section-label">Core Mechanics</p>
      <h2 id="loop-heading">Six Steps. Every Roll.</h2>
      <p class="gs-loop__intro">
        From picking a lock to commanding a naval fleet, every test in D6 Storyteller follows the same six steps:
      </p>

      <ol class="gs-steps" aria-label="Six-step core loop">
        {steps.map((step) => (
          <li class="gs-step">
            <div class="gs-step__number" aria-hidden="true">{step.number}</div>
            <div class="gs-step__content">
              <h3 class="gs-step__title">{step.title}</h3>
              <p class="gs-step__body">{step.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Dice result reference -->
  <section class="section section--tight gs-dice" aria-labelledby="dice-heading">
    <div class="container container--narrow">
      <h2 id="dice-heading">Quick Dice & Result Reference</h2>
      <p style="color:rgba(232,224,208,0.7);margin-bottom:var(--space-6);">Assemble your pool. Roll. Read the single highest die. No arithmetic needed.</p>
      <div class="gs-dice__grid">
        <div class="gs-dice__result gs-dice__result--success">
          <div class="gs-dice__face" aria-hidden="true">⚅</div>
          <div class="gs-dice__info">
            <strong class="gs-dice__value">6: Full Success</strong>
            <p>You achieve what you set out to do. Multiple 6s = Great Effect (more, faster, or lasting impact).</p>
          </div>
        </div>
        <div class="gs-dice__result gs-dice__result--partial">
          <div class="gs-dice__face" aria-hidden="true">⚄</div>
          <div class="gs-dice__info">
            <strong class="gs-dice__value">4–5: Partial Success</strong>
            <p>You accomplish your goal, but at a cost: a complication, minor harm, or reduced effect. The story moves forward.</p>
          </div>
        </div>
        <div class="gs-dice__result gs-dice__result--fail">
          <div class="gs-dice__face" aria-hidden="true">⚀</div>
          <div class="gs-dice__info">
            <strong class="gs-dice__value">1–3: Failure</strong>
            <p>You don't get what you wanted, and a consequence strikes. Failure is never a dead stop; it propels the narrative.</p>
          </div>
        </div>
      </div>
      <p class="gs-dice__note">
        <strong>Position affects consequences, not roll math.</strong> A Controlled failure is a minor setback. A Desperate failure is a major crisis. Risky sits in between.
      </p>
    </div>
  </section>

  <!-- Sample Game Walkthrough -->
  <section class="section gs-walkthrough" aria-labelledby="walkthrough-heading">
    <div class="container container--narrow">
      <p class="section-label">Actual Play Example</p>
      <h2 id="walkthrough-heading">Sample Game Walkthrough</h2>
      <p class="gs-walkthrough__intro">
        Let's walk through a live scene to see how <strong>approach</strong>, <strong>position</strong>, <strong>dice pools</strong>, and <strong>momentum</strong> interact in actual play.
      </p>

      <div class="walkthrough-box">
        <div class="walkthrough-step">
          <span class="walkthrough-step__badge">Scene Framing</span>
          <h3>The Setup: Breaking into the Alchemical Vault</h3>
          <p>
            <em>Vance</em> (a rogue investigator) is attempting to bypass a bronze alchemical lock on a vault door in the <em>Aether & Iron</em> setting. A steam-automaton sentry is patrolling the far end of the hallway.
          </p>
        </div>

        <div class="walkthrough-step">
          <span class="walkthrough-step__badge">Step 1 & 2: Approach & Position</span>
          <h3>Determining Approach, Position & Effect</h3>
          <ul class="walkthrough-list">
            <li><strong>Approach:</strong> Vance picks the lock using delicate pick tools. This is a <strong>Finesse</strong> approach (Vance has <strong>3d6</strong> in Finesse).</li>
            <li><strong>Position:</strong> The Storyteller assesses the scene: <em>"You're working quietly, but if you make noise, the sentry hears you. The position is <strong>Risky</strong>."</em></li>
            <li><strong>Effect:</strong> <em>"Your tools are tailored for alchemical locks. If you succeed, you open it cleanly. The effect is <strong>Standard</strong>."</em></li>
          </ul>
        </div>

        <div class="walkthrough-step">
          <span class="walkthrough-step__badge">Step 3: Assembling the Pool & Momentum</span>
          <h3>Modifying the Dice Pool with Momentum</h3>
          <p>
            Vance starts with <strong>3d6</strong> (Finesse rating). Wanting to ensure the door opens before the sentry turns around, Vance asks the team: <em>"Can I withdraw 1 Momentum from our team's Momentum Bank?"</em>
          </p>
          <p>
            The team agrees. Spending 1 Momentum adds <strong>+1d6</strong> to the pool. Vance assembles a final pool of <strong>4d6</strong>.
          </p>
          <div class="walkthrough-note">
            💡 <strong>Rules Note:</strong> The <em>Momentum Bank</em> is an optional plug-in mechanic. You can read the full rules for Momentum Banks and other plug-in mechanics under <a href="/supplements/#momentum-bank">Online Supplements</a>.
          </div>
        </div>

        <div class="walkthrough-step">
          <span class="walkthrough-step__badge">Step 4 & 5: Roll & Resolution</span>
          <h3>Rolling the Dice & Reading the Outcome</h3>
          <div class="walkthrough-roll-demo">
            <span class="dice-tag dice-tag--fail">1</span>
            <span class="dice-tag dice-tag--fail">3</span>
            <span class="dice-tag dice-tag--partial">4</span>
            <span class="dice-tag dice-tag--success">6</span>
            <span class="walkthrough-outcome">→ Highest Die: <strong>6 (Full Success!)</strong></span>
          </div>
          <p>
            The 6 delivers a clean <strong>Full Success</strong>. The alchemical tumbler clicks into place, and Vance slips through the vault door just as the automaton sentry turns the corner.
          </p>
        </div>

        <div class="walkthrough-step walkthrough-step--contrast">
          <span class="walkthrough-step__badge walkthrough-step__badge--alt">Contrast Example</span>
          <h3>What If the Position Was Desperate?</h3>
          <p>
            Suppose the sentry was already standing over Vance with a raised steam blade. The Storyteller declares the position is <strong>Desperate</strong>. Vance rolls 3d6 Finesse to dodge and gets a <strong>4 (Partial Success)</strong>.
          </p>
          <p>
            Because the position was Desperate, the Partial Success outcome is severe: <em>Vance dodges the fatal strike (Success!), but the superheated steam vents scorch his shoulder, inflicting a "Burned Shoulder" condition.</em> The roll result (4) remains unchanged, but the fictional stakes reflect the Desperate position!
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Characters -->
  <section class="section section--tight gs-characters" aria-labelledby="characters-heading">
    <div class="container container--narrow">
      <h2 id="characters-heading">Characters at a Glance</h2>
      <p style="color:rgba(232,224,208,0.75);margin-bottom:var(--space-6);">Every D6 Storyteller character is defined by three core elements:</p>

      <div class="gs-char-elements">
        <div class="gs-char-element card">
          <h3 class="gs-char-element__title">Descriptors</h3>
          <p class="gs-char-element__body">
            Three to five vivid phrases describing who your character is and what they do well. Descriptors establish fictional context: <em>"Former gladiator with standing among guild leaders"</em> gives your character clear authority in social or physical scenes.
          </p>
        </div>
        <div class="gs-char-element card">
          <h3 class="gs-char-element__title">Approaches (8 Dice Total)</h3>
          <p class="gs-char-element__body">
            Eight dice distributed across four approaches: <strong>Force</strong>, <strong>Finesse</strong>, <strong>Mind</strong>, and <strong>Presence</strong> (min 1d6 in each). A warrior might choose Force 3d6 / Finesse 2d6 / Mind 1d6 / Presence 2d6.
          </p>
        </div>
        <div class="gs-char-element card">
          <h3 class="gs-char-element__title">Drive & Flaw</h3>
          <p class="gs-char-element__body">
            One sentence driving what your character wants (<em>"Protect the innocent at any cost"</em>) and one flaw where they reliably stumble (<em>"Impatient when negotiations stall"</em>). Drive and flaw drive character growth and drama.
          </p>
        </div>
      </div>

      <p class="gs-characters__note">
        Every setting in the series includes three <strong>ready-to-play archetypes</strong> with pre-built descriptors and approaches so new players can jump in immediately!
      </p>
    </div>
  </section>

  <!-- Why D6 Storyteller -->
  <section class="section gs-why" aria-labelledby="why-heading">
    <div class="container container--narrow">
      <p class="section-label">Why This System</p>
      <h2 id="why-heading">Why D6 Storyteller?</h2>
      <div class="gs-why__grid">
        {whyD6.map(item => (
          <div class="gs-why__item">
            <span class="gs-why__icon" aria-hidden="true">{item.icon}</span>
            <div>
              <strong class="gs-why__title">{item.title}</strong>
              <p class="gs-why__body">{item.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- System FAQ -->
  <section class="section section--tight gs-faq" aria-labelledby="faq-heading">
    <div class="container container--narrow">
      <h2 id="faq-heading">System FAQ</h2>
      <FAQ items={faqItems} />
    </div>
  </section>

  <!-- The Books -->
  <section class="section gs-books" aria-labelledby="books-heading">
    <div class="container container--narrow">
      <p class="section-label">The Library</p>
      <h2 id="books-heading">Start Here: Core & Companions</h2>
      <p class="gs-books__intro">
        Begin with the Core Rulebook. Once your group knows the system, expand into any of the 9 genre companions: each adding ten ready-to-play settings with custom mechanics.
      </p>

      <div class="gs-books__grid">
        {books.map(book => (
          <a href={`/books/${book.slug}/`} class="gs-book-tile card">
            <img
              src={book.data.coverImage}
              alt={book.data.coverAlt}
              width="120"
              height="160"
              loading="lazy"
              class="gs-book-tile__cover"
            />
            <div class="gs-book-tile__info">
              <p class="gs-book-tile__label">
                {book.data.order === 1 ? '📗 Start Here' : `Companion ${book.data.order - 1}`}
              </p>
              <h3 class="gs-book-tile__title">{book.data.shortTitle}</h3>
              <p class="gs-book-tile__genres">{book.data.genres.slice(0, 2).join(' · ')}</p>
            </div>
          </a>
        ))}
      </div>

      <div class="gs-books__actions">
        <a href="/books/" class="btn btn--secondary">Browse All Books →</a>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="section section--tight gs-final" aria-labelledby="gs-final-heading">
    <div class="container container--narrow">
      <div class="gs-final__card glow-border">
        <span class="gs-final__dice" aria-hidden="true">⚄</span>
        <h2 id="gs-final-heading" class="glow-text">Ready to Roll?</h2>
        <p>
          The D6 Storyteller Core Rulebook has everything you need to start your first session: complete rules, character creation, Storyteller guidance, and ten ready-to-play worlds. Available on Amazon in paperback and Kindle.
        </p>
        <div class="gs-final__actions">
          <a
            href={AMAZON_URL}
            class="btn btn--primary gs-final__btn"
            target="_blank"
            rel="noopener noreferrer"
            onclick="try{if(window.gtag)gtag('event','amazon_click',{book_slug:'core-rulebook',placement:'get_started_final',destination:'book_page'});}catch(e){}"
          >
            Get the Core Rulebook on Amazon →
          </a>
          <a href="/books/" class="btn btn--secondary">Browse Full Series →</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
/* Hero */
.gs-hero__title {
  font-family: var(--font-display);
  font-size: clamp(var(--text-3xl), 5vw, var(--text-5xl));
  margin-bottom: var(--space-6);
  background: linear-gradient(135deg, var(--gold-300) 0%, var(--gold-400) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.gs-hero__lead {
  font-size: var(--text-xl);
  color: rgba(232, 224, 208, 0.85);
  line-height: 1.6;
  max-width: 68ch;
}

/* Fiction First Callout */
.gs-callout {
  background: var(--navy-900);
  border-left: 4px solid var(--gold-400);
  border-radius: 0 var(--radius-md) var(--radius-md) 0;
  padding: var(--space-6);
  margin-top: var(--space-4);
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}
.gs-callout p { margin: 0; color: rgba(232, 224, 208, 0.85); line-height: 1.7; }
.gs-callout strong { color: var(--gold-300); }

/* How to Play video */
.gs-video__intro {
  font-size: var(--text-lg);
  color: rgba(232, 224, 208, 0.8);
  max-width: 68ch;
  margin-bottom: var(--space-6);
  line-height: 1.6;
}
.gs-video__figure {
  margin: 0;
  border: 1px solid rgba(201, 162, 39, 0.25);
  border-radius: var(--radius-lg);
  overflow: hidden;
  background: var(--navy-950);
  box-shadow: 0 18px 44px rgba(0, 0, 0, 0.45);
}
.gs-video__player {
  display: block;
  width: 100%;
  height: auto;
  aspect-ratio: 16 / 9;
  background: var(--navy-950);
}
.gs-video__player:focus-visible { outline: 2px solid var(--gold-400); outline-offset: -2px; }
