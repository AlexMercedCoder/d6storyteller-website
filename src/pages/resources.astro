---
import BaseLayout from '../layouts/BaseLayout.astro';
import AmazonCTA from '../components/AmazonCTA.astro';
---

<BaseLayout
  title="D6 Storyteller Resources | Character Sheets & Downloads"
  description="Free resources for D6 Storyteller: character sheets, quick reference guides, errata, and links for players and Storytellers. More downloads coming soon."
  canonicalUrl="https://d6storyteller.alexmerced.com/resources/"
>
  <section class="section" aria-labelledby="resources-heading">
    <div class="container container--narrow">
      <nav aria-label="Breadcrumb" class="breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__separator" aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Resources</span>
      </nav>

      <p class="section-label">Downloads & References</p>
      <h1 id="resources-heading">D6 Storyteller Resources</h1>
      <p style="color:rgba(232,224,208,0.75);margin-bottom:var(--space-8);max-width:64ch;">
        Tools and downloads to support your D6 Storyteller campaigns: character sheets, quick reference cards, and errata. Check back as additional resources are added.
      </p>

      <div class="resource-section">
        <h2>Character Sheets</h2>
        <p class="coming-soon-notice">Character sheets for the Core Rulebook and all companion volumes are coming soon. Subscribe to updates at <a href="https://WhoIsAlexMerced.com" target="_blank" rel="noopener noreferrer">WhoIsAlexMerced.com</a> to be notified when downloads become available.</p>
      </div>

      <div class="resource-section">
        <h2>Quick Reference</h2>
        <p class="coming-soon-notice">A printable quick reference card for the core D6 mechanics is in preparation.</p>
      </div>

      <div class="resource-section">
        <h2>Errata</h2>
        <p>No errata have been issued for the current edition of D6 Storyteller. This page will be updated if any corrections are required. <em>Last reviewed: July 2026.</em></p>
      </div>

      <div class="resource-section">
        <h2>External Links</h2>
        <ul>
          <li><a href="https://www.amazon.com/dp/B0HC4XMKW3?binding=paperback&ref_=saga_sdp_cft_dsk" target="_blank" rel="noopener noreferrer">Complete D6 Storyteller Series on Amazon</a></li>
          <li><a href="https://WhoIsAlexMerced.com" target="_blank" rel="noopener noreferrer">Alex Merced's website</a></li>
          <li><a href="https://books.alexmerced.com" target="_blank" rel="noopener noreferrer">books.alexmerced.com</a></li>
        </ul>
      </div>

      <AmazonCTA placement="resources_bottom" variant="banner" />
    </div>
  </section>
</BaseLayout>

<style>
.resource-section { margin-bottom: var(--space-10); }
.resource-section h2 { margin-bottom: var(--space-4); font-size: var(--text-2xl); }
.coming-soon-notice {
  background: var(--navy-800);
  border: 1px solid rgba(201,162,39,0.2);
  border-radius: var(--radius-md);
  padding: var(--space-6);
  color: rgba(232,224,208,0.7);
  font-style: italic;
}
</style>
