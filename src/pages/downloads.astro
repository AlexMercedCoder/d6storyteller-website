---
import BaseLayout from '../layouts/BaseLayout.astro';
import AmazonCTA from '../components/AmazonCTA.astro';

interface Download {
  id: string;
  title: string;
  subtitle: string;
  icon: string;
  description: string;
  features: string[];
  href: string;
  tag: string;
  tagStyle: string;
  optionalMechanicLink?: string;
}

const coreDownloads: Download[] = [
  {
    id: 'character-sheet',
    title: 'Core Character Sheet',
    subtitle: 'For players',
    icon: '📋',
    description: 'The standard D6 Storyteller character sheet covering everything in the core rules. Approaches (Force/Finesse/Mind/Presence), Descriptors, Drive & Flaw, conditions with severity effects and the recovery procedure, setting-specific mechanic box, bonds & contacts, and an inline dice reference. No optional mechanics clutter.',
    features: [
      'Approach boxes with 4-pip notation (●●●○ = 3d6)',
      'Five descriptor lines',
      'Drive & Flaw blocks (one line each)',
      'Three-tier condition palette with mechanical effects and recovery rule',
      'Setting-specific mechanic box (fill in from companion)',
      'Bonds, contacts, and notes sections',
      'Inline dice reference (6 / 4–5 / 1–3)',
      'Link to optional mechanics add-on sheet',
    ],
    href: '/downloads/d6-character-sheet.html',
    tag: 'Core Rules',
    tagStyle: 'background:rgba(39,174,96,0.15);color:#1a6a30;',
  },
];

const optionalDownloads: Download[] = [
  {
    id: 'optional-addon',
    title: 'Optional Mechanics Character Add-On',
    subtitle: 'Attach to the Core Character Sheet',
    icon: '⚙️',
    description: 'A companion sheet for players using optional mechanics. Covers the five per-character optional rules — each with its mechanic number, a link to the full rules on the Optional Mechanics page, an inline rule summary, and a dedicated tracking section. Only print the sections your group is using.',
    features: [
      'Wound Clock — 4-segment visual tracker + effects table (Graze / Wound / Severe / Out)',
      'Momentum Bank — 6 bankable token boxes with clear-at-session reminder',
      'Emotional Burden — 5-circle track with milestone notes (3 → narrow approaches, 5 → Breaking Point)',
      'Reputation Web — 5 faction rows with Trusted / Neutral / Wanted stance badges',
      'Legacy Move — one-per-arc pip, declaration + descriptor + consequence fields',
      'Every mechanic links directly to d6storyteller.alexmerced.com/optional-mechanics/',
    ],
    href: '/downloads/d6-optional-mechanics-addon.html',
    tag: 'Optional Rules',
    tagStyle: 'background:rgba(201,162,39,0.15);color:#806000;',
    optionalMechanicLink: '/optional-mechanics/',
  },
];

const partyDownloads: Download[] = [
  {
    id: 'clocks-tracker',
    title: 'Clocks & Tracks (Party Sheet)',
    subtitle: 'One sheet for the whole table',
    icon: '⏱️',
    description: 'A shared table resource for tracking all the party-wide optional mechanics at once. Six Ticking Clock blocks, five Wound Clock trackers (one per character), the shared Momentum Bank, the Escalating Stakes track, and four Emotional Burden circles. Place in the center of the table.',
    features: [
      'Six Ticking Clock cards — name, what happens at zero, 6 countdown boxes each',
      'Five Wound Clock trackers (1 per character) with severity labels',
      'Shared Momentum Bank — 6 boxes, resets each session',
      'Escalating Stakes track 1–5 with consequence note',
      'Four Emotional Burden tracks (5 circles each)',
    ],
    href: '/downloads/d6-clocks-tracker.html',
    tag: 'Party / Table',
    tagStyle: 'background:rgba(80,120,200,0.15);color:#2a4a90;',
    optionalMechanicLink: '/optional-mechanics/',
  },
  {
    id: 'group-roster',
    title: 'Group Roster',
    subtitle: "Storyteller's at-a-glance view",
    icon: '👥',
    description: "A Storyteller-facing sheet giving an at-a-glance view of all four player characters on one page — each card shows key descriptor, Drive/Flaw, approach dice boxes, condition slots, Wound Clock, and Emotional Burden. Includes an NPC/contacts table with Ally/Neutral/Hostile stance badges.",
    features: [
      'Four player character rows — name, player, setting, archetype',
      'Per-character: approach boxes (Fo/Fi/Mi/Pr), condition slots, Wound + Burden tracks',
      'Key descriptor and Drive/Flaw field per character',
      'NPC table: name, faction, stance (Ally / Neutral / Hostile), want, notes',
      'Campaign meta header: campaign name, session number, date',
    ],
    href: '/downloads/d6-group-roster.html',
    tag: 'Storyteller',
    tagStyle: 'background:rgba(80,120,200,0.15);color:#2a4a90;',
  },
];

const storytellerDownloads: Download[] = [
  {
    id: 'reference-card',
    title: 'Storyteller Quick Reference',
    subtitle: 'Core rules at a glance',
    icon: '📖',
    description: 'A single-page rules reference covering every table a Storyteller needs mid-session: dice results, position table with failure costs, effect levels, approach definitions, conditions + recovery, assist rules, Ticking Clock quick reference, and Storyteller principles.',
    features: [
      'Dice results: Full Success / Partial / Failure with detailed descriptions',
      'Position table: Controlled / Risky / Desperate with failure costs',
      'Effect levels: Great / Standard / Limited',
      'Four approach definitions',
      'Conditions + recovery procedure',
      'Assist rules and Storyteller principles',
    ],
    href: '/downloads/d6-storyteller-reference.html',
    tag: 'Storyteller',
    tagStyle: 'background:rgba(80,120,200,0.15);color:#2a4a90;',
  },
  {
    id: 'session-planner',
    title: 'Session Planner',
    subtitle: 'Pre-session prep sheet',
    icon: '🗂️',
    description: 'A structured pre-session planning sheet. Covers opening scene setup (including what the players don\'t know), three optional scene frames (trigger / escalation / payoff), key NPCs with wants and methods, four Ticking Clock trackers, and session notes.',
    features: [
      'Session meta: campaign, number, the big question for this session',
      'Opening scene block with hidden information field',
      'Three scene frames (A / B / C) — not required, improvise freely',
      'NPC table: name, want, method (5 rows)',
      'Four Ticking Clock trackers with 6 countdown boxes each',
      'Loose threads + session outcome notes',
    ],
    href: '/downloads/d6-session-planner.html',
    tag: 'Storyteller',
    tagStyle: 'background:rgba(80,120,200,0.15);color:#2a4a90;',
  },
];

type Category = { heading: string; lead: string; badge: string; badgeStyle: string; downloads: Download[]; anchor: string; };

const categories: Category[] = [
  {
    anchor: 'core',
    heading: 'Core Rules Sheets',
    badge: 'Core Rules',
    badgeStyle: 'background:rgba(39,174,96,0.15);color:#1a6a30;border-color:rgba(39,174,96,0.3);',
    lead: 'These sheets cover only what is in the core D6 Storyteller rules — approaches, descriptors, drive & flaw, conditions, and the core dice mechanic. No optional rules included.',
    downloads: coreDownloads,
  },
  {
    anchor: 'optional',
    heading: 'Optional Mechanics Sheets',
    badge: 'Optional Rules',
    badgeStyle: 'background:rgba(201,162,39,0.15);color:#806000;border-color:rgba(201,162,39,0.3);',
    lead: 'These sheets track the optional plug-in mechanics from the Optional Mechanics page. Each section on the add-on sheet clearly labels which optional mechanic it belongs to, with a direct link to the full rules. Only use the sections your group has agreed to use.',
    downloads: optionalDownloads,
  },
  {
    anchor: 'party',
    heading: 'Party & Table Sheets',
    badge: 'Party / Table',
    badgeStyle: 'background:rgba(80,120,200,0.15);color:#2a4a90;border-color:rgba(80,120,200,0.3);',
    lead: 'Shared sheets for the whole table — tracking party-wide optional mechanics, all player characters at a glance, and NPCs.',
    downloads: partyDownloads,
  },
  {
    anchor: 'storyteller',
    heading: 'Storyteller Sheets',
    badge: 'Storyteller',
    badgeStyle: 'background:rgba(80,120,200,0.15);color:#2a4a90;border-color:rgba(80,120,200,0.3);',
    lead: 'Reference and planning sheets for the Storyteller — the rules quick reference card and a structured session prep sheet.',
    downloads: storytellerDownloads,
  },
];
---

<BaseLayout
  title="D6 Storyteller Free Downloads | Character Sheets & Storyteller Aids"
  description="Free printable downloads for D6 Storyteller — core character sheets, optional mechanics add-on sheets, party trackers, Storyteller reference card, and session planner. Print directly or save as PDF."
  canonicalUrl="https://d6storyteller.alexmerced.com/downloads/"
>
  <section class="section" aria-labelledby="downloads-heading">
    <div class="container">

      <nav aria-label="Breadcrumb" class="breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__separator" aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Downloads</span>
      </nav>

      <p class="section-label">Free Resources</p>
      <h1 id="downloads-heading">Downloads</h1>
      <p class="dl-intro">
        Free printable sheets for D6 Storyteller players and Storytellers. Open any sheet in your browser, then use <strong>Print → Save as PDF</strong> or print directly. All sheets are formatted for US Letter (8.5" × 11"). No account or email required.
      </p>

      <!-- What sheet do I need? -->
      <div class="dl-guide card">
        <h2 class="dl-guide__heading">Which sheet do I need?</h2>
        <div class="dl-guide__grid">
          <div class="dl-guide__item">
            <span class="dl-guide__icon" aria-hidden="true">📋</span>
            <div>
              <strong>Every player needs</strong>
              <p>One <a href="#core">Core Character Sheet</a> per character — covers the base game only.</p>
            </div>
          </div>
          <div class="dl-guide__item">
            <span class="dl-guide__icon" aria-hidden="true">⚙️</span>
            <div>
              <strong>Using optional mechanics?</strong>
              <p>Attach the <a href="#optional">Optional Mechanics Add-On</a> to the core sheet. Read the <a href="/optional-mechanics/">Optional Mechanics page</a> first — these rules are opt-in, not default.</p>
            </div>
          </div>
          <div class="dl-guide__item">
            <span class="dl-guide__icon" aria-hidden="true">⏱️</span>
            <div>
              <strong>Tracking clocks & party-wide rules?</strong>
              <p>Print one <a href="#party">Clocks & Tracks sheet</a> per session and place it in the center of the table.</p>
            </div>
          </div>
          <div class="dl-guide__item">
            <span class="dl-guide__icon" aria-hidden="true">📖</span>
            <div>
              <strong>For the Storyteller</strong>
              <p>The <a href="#storyteller">Quick Reference card</a> covers every rules table mid-session. The <a href="#storyteller">Session Planner</a> is for pre-session prep.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Quick jump -->
      <nav class="dl-quicknav" aria-label="Jump to category">
        {categories.map(cat => (
          <a href={`#${cat.anchor}`} class="dl-quicknav__link">
            <span class="dl-quicknav__badge" style={cat.badgeStyle}>{cat.badge}</span>
            {cat.heading}
          </a>
        ))}
      </nav>

      <!-- Categories -->
      {categories.map(cat => (
        <div class="dl-category" id={cat.anchor}>
          <div class="dl-category__header">
            <span class="dl-category__badge" style={cat.badgeStyle}>{cat.badge}</span>
            <h2 class="dl-category__heading">{cat.heading}</h2>
          </div>
          <p class="dl-category__lead">{cat.lead}</p>

          <div class="dl-grid">
            {cat.downloads.map(dl => (
              <article class="dl-card card" id={dl.id}>
                <div class="dl-card__header">
                  <span class="dl-card__icon" aria-hidden="true">{dl.icon}</span>
                  <div class="dl-card__title-block">
                    <h3 class="dl-card__title">{dl.title}</h3>
                    <p class="dl-card__subtitle">{dl.subtitle}</p>
                    {dl.optionalMechanicLink && (
                      <a href={dl.optionalMechanicLink} class="dl-card__mechanic-link">
                        View Optional Mechanics rules →
                      </a>
                    )}
                  </div>
                </div>

                <p class="dl-card__description">{dl.description}</p>

                <div class="dl-card__features">
                  <p class="dl-card__features-label">What's included:</p>
                  <ul>
                    {dl.features.map(f => <li>{f}</li>)}
                  </ul>
                </div>

                <div class="dl-card__actions">
                  <a
                    href={dl.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="dl-card__btn dl-card__btn--primary"
                    aria-label={`Open ${dl.title} in browser`}
                  >
                    <span aria-hidden="true">↗</span> Open Sheet
                  </a>
                  <a
                    href={dl.href}
                    download
                    class="dl-card__btn dl-card__btn--secondary"
                    aria-label={`Download ${dl.title}`}
                  >
                    <span aria-hidden="true">⬇</span> Download
                  </a>
                </div>

                <p class="dl-card__hint">
                  To save as PDF: Open → <kbd>Ctrl+P</kbd> → Destination: Save as PDF → Print
                </p>
              </article>
            ))}
          </div>
        </div>
      ))}

      <!-- Printing tips -->
      <div class="dl-tips">
        <h2>Printing Tips</h2>
        <div class="dl-tips__grid">
          <div class="dl-tip">
            <span class="dl-tip__icon" aria-hidden="true">🖨️</span>
            <div>
              <strong>Save as PDF first</strong>
              <p>Open the sheet, press <kbd>Ctrl+P</kbd> (or <kbd>⌘+P</kbd> on Mac), choose <em>Save as PDF</em>. This preserves formatting and lets you share or archive it.</p>
            </div>
          </div>
          <div class="dl-tip">
            <span class="dl-tip__icon" aria-hidden="true">📄</span>
            <div>
              <strong>Paper size</strong>
              <p>All sheets are formatted for US Letter (8.5" × 11"). If printing A4, select <em>Fit to page</em> — the layout scales cleanly.</p>
            </div>
          </div>
          <div class="dl-tip">
            <span class="dl-tip__icon" aria-hidden="true">🎨</span>
            <div>
              <strong>Background graphics</strong>
              <p>Enable <em>Background graphics</em> in print settings for the full navy header. Disable to save ink — all sheets are fully readable in black and white.</p>
            </div>
          </div>
          <div class="dl-tip">
            <span class="dl-tip__icon" aria-hidden="true">⚙️</span>
            <div>
              <strong>Optional mechanics are opt-in</strong>
              <p>Don't print the add-on sheets until your group decides to use an optional mechanic. Read <a href="/optional-mechanics/">Optional Mechanics</a> first, then pick what fits your campaign.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- CTA -->
      <AmazonCTA placement="downloads_bottom" variant="banner" label="Get the D6 Storyteller Series on Amazon" />
    </div>
  </section>
</BaseLayout>

<style>
.dl-intro {
  max-width: 72ch;
  color: rgba(232, 224, 208, 0.8);
  margin-bottom: var(--space-8);
}
.dl-intro strong { color: var(--gold-300); }

/* Guide box */
.dl-guide {
  margin-bottom: var(--space-8);
  padding: var(--space-6) var(--space-8);
}
.dl-guide__heading {
  font-size: var(--text-xl);
  color: var(--gold-300);
  margin-bottom: var(--space-5);
}
.dl-guide__grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: var(--space-4);
}
.dl-guide__item {
  display: flex;
  gap: var(--space-3);
  align-items: flex-start;
}
.dl-guide__icon { font-size: 1.5rem; flex-shrink: 0; }
.dl-guide__item strong { display: block; color: var(--gold-300); font-family: var(--font-heading); font-size: var(--text-sm); margin-bottom: var(--space-1); }
.dl-guide__item p { font-size: var(--text-sm); color: rgba(232,224,208,0.65); margin: 0; }
.dl-guide__item a { color: var(--gold-400); }

/* Quick nav */
.dl-quicknav {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  margin-bottom: var(--space-10);
}
.dl-quicknav__link {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  font-family: var(--font-heading);
  font-size: var(--text-xs);
  letter-spacing: 0.06em;
  color: rgba(232,224,208,0.65);
  text-decoration: none;
  padding: 0.35em 0.9em;
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 999px;
  transition: all var(--transition-fast);
}
.dl-quicknav__link:hover {
  color: var(--gold-300);
  border-color: var(--gold-500);
  background: rgba(201,162,39,0.06);
  text-shadow: none;
}
.dl-quicknav__badge {
  font-size: 0.6rem;
  font-family: var(--font-heading);
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  padding: 1px 6px;
  border-radius: 999px;
  border: 1px solid transparent;
}

/* Category */
.dl-category {
  margin-bottom: var(--space-12);
  scroll-margin-top: 80px;
}
.dl-category__header {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-3);
}
.dl-category__badge {
  font-family: var(--font-heading);
  font-size: var(--text-xs);
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  padding: 2px 10px;
  border-radius: 999px;
  border: 1px solid transparent;
  flex-shrink: 0;
}
.dl-category__heading {
  font-size: var(--text-2xl);
  color: var(--gold-300);
  margin: 0;
}
.dl-category__lead {
  font-size: var(--text-sm);
  color: rgba(232,224,208,0.65);
  max-width: 72ch;
  margin-bottom: var(--space-6);
}

/* Download grid */
.dl-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
  gap: var(--space-5);
}

/* Download card */
.dl-card {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
  padding: var(--space-6);
}
.dl-card__header {
  display: flex;
  align-items: flex-start;
  gap: var(--space-4);
}
.dl-card__icon { font-size: 2.25rem; flex-shrink: 0; }
.dl-card__title-block { display: flex; flex-direction: column; gap: var(--space-1); }
.dl-card__title { font-size: var(--text-xl); color: var(--gold-300); margin: 0; }
.dl-card__subtitle {
  font-size: var(--text-xs);
  color: rgba(232,224,208,0.4);
  font-family: var(--font-heading);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  margin: 0;
}
.dl-card__mechanic-link {
  font-size: var(--text-xs);
  font-family: var(--font-heading);
  letter-spacing: 0.06em;
  color: var(--gold-400);
  text-decoration: none;
}
.dl-card__mechanic-link:hover { text-shadow: none; color: var(--gold-300); }

.dl-card__description {
  font-size: var(--text-sm);
  color: rgba(232,224,208,0.78);
  line-height: 1.65;
  margin: 0;
}

.dl-card__features {
  background: rgba(201,162,39,0.04);
  border: 1px solid rgba(201,162,39,0.12);
  border-radius: var(--radius-md);
  padding: var(--space-4);
}
.dl-card__features-label {
  font-family: var(--font-heading);
  font-size: 0.6rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--gold-400);
  margin-bottom: var(--space-2);
}
.dl-card__features ul { list-style: none; padding: 0; display: flex; flex-direction: column; gap: var(--space-1); }
.dl-card__features li {
  font-size: var(--text-xs);
  color: rgba(232,224,208,0.68);
  padding-left: var(--space-4);
  position: relative;
  line-height: 1.5;
}
.dl-card__features li::before {
  content: '⚄';
  position: absolute;
  left: 0;
  font-size: 0.6rem;
  color: var(--gold-400);
  top: 1px;
}

.dl-card__actions {
  display: flex;
  gap: var(--space-3);
  margin-top: auto;
}
.dl-card__btn {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  font-family: var(--font-heading);
  font-size: var(--text-sm);
  letter-spacing: 0.08em;
  text-decoration: none;
  padding: 0.6em 1.2em;
  border-radius: var(--radius-md);
  border: 1.5px solid;
  transition: all var(--transition-fast);
}
.dl-card__btn--primary {
  background: var(--gold-500);
  color: var(--navy-900);
  border-color: var(--gold-500);
  font-weight: 600;
}
.dl-card__btn--primary:hover { background: var(--gold-300); border-color: var(--gold-300); text-shadow: none; }
.dl-card__btn--secondary {
  background: transparent;
  color: var(--gold-400);
  border-color: rgba(201,162,39,0.4);
}
.dl-card__btn--secondary:hover { background: rgba(201,162,39,0.08); border-color: var(--gold-400); text-shadow: none; }

.dl-card__hint {
  font-size: 0.62rem;
  color: rgba(232,224,208,0.3);
  font-family: var(--font-heading);
  letter-spacing: 0.05em;
}
kbd {
  font-family: monospace;
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.15);
  border-radius: 3px;
  padding: 0.05em 0.4em;
  font-size: 0.95em;
}

/* Tips */
.dl-tips {
  background: var(--navy-800);
  border: 1px solid rgba(201,162,39,0.2);
  border-radius: var(--radius-lg);
  padding: var(--space-8);
  margin-bottom: var(--space-8);
}
.dl-tips h2 { font-size: var(--text-2xl); margin-bottom: var(--space-6); }
.dl-tips__grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-5); }
@media (max-width: 640px) {
  .dl-tips__grid { grid-template-columns: 1fr; }
  .dl-grid { grid-template-columns: 1fr; }
}
.dl-tip { display: flex; gap: var(--space-3); align-items: flex-start; }
.dl-tip__icon { font-size: 1.5rem; flex-shrink: 0; }
.dl-tip strong { display: block; color: var(--gold-300); font-family: var(--font-heading); font-size: var(--text-sm); margin-bottom: var(--space-1); }
.dl-tip p { font-size: var(--text-sm); color: rgba(232,224,208,0.65); margin: 0; line-height: 1.55; }
.dl-tip a { color: var(--gold-400); }
</style>
