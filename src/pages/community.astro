---
import BaseLayout from '../layouts/BaseLayout.astro';
import AmazonCTA from '../components/AmazonCTA.astro';

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://d6storyteller.alexmerced.com/community/#webpage",
    "url": "https://d6storyteller.alexmerced.com/community/",
    "name": "D6 Storyteller Community | Connect, Share, and Play",
    "description": "Find your people: join the D6 Storyteller Slack community, build a local group, share homebrew settings and rules, and connect with Storytellers and players worldwide.",
    "isPartOf": { "@id": "https://d6storyteller.alexmerced.com/#website" },
    "inLanguage": "en-US"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://d6storyteller.alexmerced.com/" },
      { "@type": "ListItem", "position": 2, "name": "Community", "item": "https://d6storyteller.alexmerced.com/community/" }
    ]
  }
];
---

<BaseLayout
  title="D6 Storyteller Community | Connect, Share, and Play"
  description="Find your people: join the D6 Storyteller Slack community, build a local group, share homebrew settings and rules, and connect with Storytellers and players worldwide."
  canonicalUrl="https://d6storyteller.alexmerced.com/community/"
  jsonLd={jsonLd}
>
  <section class="section" aria-labelledby="community-heading">
    <div class="container container--narrow">
      <nav aria-label="Breadcrumb" class="breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__separator" aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Community</span>
      </nav>

      <p class="section-label">Find Your Table</p>
      <h1 id="community-heading">D6 Storyteller Community</h1>
      <p class="page-intro">
        D6 Storyteller works best when it gets played. This page lists the places where players,
        Storytellers, and creators gather to share campaigns, homebrew rules, setting ideas, and
        everything else that happens when a community builds around a game it cares about.
      </p>

      <!-- Slack -->
      <div class="outlet-card" id="slack-community">
        <div class="outlet-card__header">
          <div class="outlet-card__icon" aria-hidden="true">
            <svg width="32" height="32" viewBox="0 0 54 54" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M19.7 33.6c0 2.7-2.2 4.9-4.9 4.9s-4.9-2.2-4.9-4.9 2.2-4.9 4.9-4.9h4.9v4.9z" fill="#E01E5A"/>
              <path d="M22.2 33.6c0-2.7 2.2-4.9 4.9-4.9s4.9 2.2 4.9 4.9v12.3c0 2.7-2.2 4.9-4.9 4.9s-4.9-2.2-4.9-4.9V33.6z" fill="#E01E5A"/>
              <path d="M27.1 19.7c-2.7 0-4.9-2.2-4.9-4.9s2.2-4.9 4.9-4.9 4.9 2.2 4.9 4.9v4.9h-4.9z" fill="#36C5F0"/>
              <path d="M27.1 22.2c2.7 0 4.9 2.2 4.9 4.9s-2.2 4.9-4.9 4.9H14.8c-2.7 0-4.9-2.2-4.9-4.9s2.2-4.9 4.9-4.9h12.3z" fill="#36C5F0"/>
              <path d="M41 27.1c0-2.7 2.2-4.9 4.9-4.9s4.9 2.2 4.9 4.9-2.2 4.9-4.9 4.9H41v-4.9z" fill="#2EB67D"/>
              <path d="M38.5 27.1c0 2.7-2.2 4.9-4.9 4.9s-4.9-2.2-4.9-4.9V14.8c0-2.7 2.2-4.9 4.9-4.9s4.9 2.2 4.9 4.9v12.3z" fill="#2EB67D"/>
              <path d="M33.6 41c2.7 0 4.9 2.2 4.9 4.9s-2.2 4.9-4.9 4.9-4.9-2.2-4.9-4.9V41h4.9z" fill="#ECB22E"/>
              <path d="M33.6 38.5c-2.7 0-4.9-2.2-4.9-4.9s2.2-4.9 4.9-4.9h12.3c2.7 0 4.9 2.2 4.9 4.9s-2.2 4.9-4.9 4.9H33.6z" fill="#ECB22E"/>
            </svg>
          </div>
          <div class="outlet-card__title-block">
            <h2 class="outlet-card__name">D6 Storyteller Slack</h2>
            <span class="outlet-card__type">Official Community Hub</span>
          </div>
        </div>

        <p class="outlet-card__description">
          The D6 Storyteller Slack is the central gathering place for the community. Join to find
          players and Storytellers from around the world, share what you are running, get feedback
          on settings and homebrew, and connect with people who want to play.
        </p>

        <div class="outlet-card__channels">
          <h3>Channels you join automatically</h3>
          <p class="channels-note">Every new member is added to these channels the moment they join:</p>
          <ul class="channel-list">
            <li>
              <span class="channel-tag">#all-d6storyteller-community</span>
              The workspace-wide channel. Every member is here - great for announcements that reach everyone.
            </li>
            <li>
              <span class="channel-tag channel-tag--landing">#announcements</span>
              <span class="channel-landing-badge">Landing channel</span>
              Your first stop on arrival. Watch here for news, new releases, and official updates from the D6 Storyteller team.
            </li>
            <li>
              <span class="channel-tag">#social</span>
              General conversation, introductions, off-topic chat, and everything that does not fit neatly somewhere else.
            </li>
            <li>
              <span class="channel-tag">#resources</span>
              Share and discover community-made supplements, settings, tools, and reference materials.
            </li>
          </ul>
        </div>

        <div class="outlet-card__local">
          <h3>Build a local channel</h3>
          <p>
            If you have a local gaming group or want to start one, create a city or region channel
            in the Slack - something like <code>#local-austin</code> or <code>#local-london</code>.
            Local channels are the best way to find people in your area for in-person sessions,
            one-shots, and conventions. Anyone in the workspace can create a channel: just use the
            <strong>+ Add Channel</strong> button in the sidebar.
          </p>
        </div>

        <a
          href="https://join.slack.com/t/d6storyteller-xnv2998/shared_invite/zt-45xlp464g-fZDcIpiP5cxqKXgJN8MqsA"
          class="outlet-card__cta btn btn--primary"
          target="_blank"
          rel="noopener noreferrer"
          id="slack-join-button"
        >
          Join the Slack Community
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>

      <!-- Reddit -->
      <div class="outlet-card outlet-card--reddit" id="reddit-community">
        <div class="outlet-card__header">
          <div class="outlet-card__icon">
            <svg width="32" height="32" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <circle cx="10" cy="10" r="10" fill="#FF4500"/>
              <path d="M16.67 10a1.46 1.46 0 0 0-2.47-1 7.12 7.12 0 0 0-3.85-1.23l.65-3.07 2.13.45a1 1 0 1 0 .98-1.15 1 1 0 0 0-.95.68l-2.37-.5a.17.17 0 0 0-.2.13l-.73 3.43a7.14 7.14 0 0 0-3.89 1.24 1.46 1.46 0 1 0-1.61 2.39 2.87 2.87 0 0 0 0 .4c0 2.02 2.35 3.66 5.25 3.66s5.25-1.64 5.25-3.66a2.87 2.87 0 0 0 0-.4 1.46 1.46 0 0 0 .76-1.37zM7.5 11a1 1 0 1 1 1 1 1 1 0 0 1-1-1zm5.58 2.65a3.54 3.54 0 0 1-2.08.55 3.54 3.54 0 0 1-2.08-.55.17.17 0 0 1 .2-.27 3.2 3.2 0 0 0 1.88.48 3.2 3.2 0 0 0 1.88-.48.17.17 0 1 1 .2.27zm-.08-1.65a1 1 0 1 1 1-1 1 1 0 0 1-1 1z" fill="white"/>
            </svg>
          </div>
          <div class="outlet-card__title-block">
            <h2 class="outlet-card__name">r/d6storyteller</h2>
            <span class="outlet-card__type">Reddit Community</span>
          </div>
        </div>

        <p class="outlet-card__description">
          The D6 Storyteller subreddit is a great place to share longer posts, campaign write-ups,
          setting concepts, and questions you want the wider Reddit community to weigh in on.
          Upvote content you find useful and leave comments to help others build better campaigns.
        </p>

        <div class="outlet-card__channels outlet-card__channels--reddit">
          <h3>What to post here</h3>
          <ul class="channel-list">
            <li>
              <span class="channel-tag channel-tag--reddit">Campaign Recaps</span>
              Share how your sessions went - memorable moments, unexpected twists, and lessons learned.
            </li>
            <li>
              <span class="channel-tag channel-tag--reddit">Setting Concepts</span>
              Post original world-building ideas and get community feedback before you play-test them.
            </li>
            <li>
              <span class="channel-tag channel-tag--reddit">Rules Questions</span>
              Ask clarifying questions about mechanics and see how others handle edge cases at their tables.
            </li>
            <li>
              <span class="channel-tag channel-tag--reddit">Homebrew Showcase</span>
              Share finished homebrew settings, mechanics, or supplements for the community to download and use.
            </li>
          </ul>
        </div>

        <a
          href="https://www.reddit.com/r/d6storyteller/"
          class="outlet-card__cta outlet-card__cta--reddit btn"
          target="_blank"
          rel="noopener noreferrer"
          id="reddit-join-button"
        >
          Visit r/d6storyteller
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>

      <!-- Placeholder for future outlets -->
      <div class="more-outlets">
        <h2>More community spaces coming</h2>
        <p>
          Additional spaces - Discord, regional groups, and more - will be listed here as the
          community grows. If you run a D6 Storyteller community space and want it included,
          reach out through the Slack or post in the subreddit.
        </p>
      </div>

      <AmazonCTA placement="community_bottom" variant="banner" />
    </div>
  </section>
</BaseLayout>

<style>
.page-intro {
  color: rgba(232, 224, 208, 0.75);
  margin-bottom: var(--space-10);
  max-width: 68ch;
  font-size: var(--text-lg);
  line-height: 1.7;
}

/* Outlet card */
.outlet-card {
  background: var(--navy-800);
  border: 1px solid rgba(201, 162, 39, 0.25);
  border-radius: var(--radius-lg);
  padding: var(--space-8);
  margin-bottom: var(--space-10);
  position: relative;
  overflow: hidden;
}

.outlet-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: linear-gradient(90deg, #E01E5A, #36C5F0, #2EB67D, #ECB22E);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
}

.outlet-card__header {
  display: flex;
  align-items: center;
  gap: var(--space-5);
  margin-bottom: var(--space-6);
}

.outlet-card__icon {
  background: rgba(255, 255, 255, 0.06);
  border-radius: var(--radius-md);
  padding: var(--space-3);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.outlet-card__name {
  font-size: var(--text-2xl);
  font-weight: 700;
  color: var(--gold-400);
  margin: 0 0 var(--space-1) 0;
}

.outlet-card__type {
  font-size: var(--text-sm);
  color: rgba(232, 224, 208, 0.5);
  font-weight: 500;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

.outlet-card__description {
  color: rgba(232, 224, 208, 0.8);
  line-height: 1.7;
  margin-bottom: var(--space-8);
  max-width: 70ch;
}

/* Channel list */
.outlet-card__channels {
  background: rgba(0, 0, 0, 0.25);
  border-radius: var(--radius-md);
  padding: var(--space-6);
  margin-bottom: var(--space-6);
}

.outlet-card__channels h3,
.outlet-card__local h3 {
  font-size: var(--text-base);
  font-weight: 700;
  color: var(--gold-300);
  margin: 0 0 var(--space-4) 0;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.channel-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.channel-list li {
  display: flex;
  align-items: baseline;
  gap: var(--space-3);
  color: rgba(232, 224, 208, 0.75);
  line-height: 1.5;
  flex-wrap: wrap;
}

.channel-tag {
  font-family: 'JetBrains Mono', 'Fira Code', monospace;
  font-size: var(--text-sm);
  background: rgba(201, 162, 39, 0.15);
  color: var(--gold-300);
  border: 1px solid rgba(201, 162, 39, 0.3);
  border-radius: var(--radius-sm);
  padding: 2px 8px;
  white-space: nowrap;
  flex-shrink: 0;
}

.channel-tag--landing {
  background: rgba(52, 168, 83, 0.15);
  color: #6fcf97;
  border-color: rgba(52, 168, 83, 0.35);
}

.channel-landing-badge {
  font-size: var(--text-xs);
  background: rgba(52, 168, 83, 0.2);
  color: #6fcf97;
  border: 1px solid rgba(52, 168, 83, 0.35);
  border-radius: 999px;
  padding: 1px 8px;
  font-weight: 600;
  letter-spacing: 0.04em;
  flex-shrink: 0;
  white-space: nowrap;
}

.channels-note {
  font-size: var(--text-sm);
  color: rgba(232, 224, 208, 0.5);
  margin: 0 0 var(--space-4) 0;
  font-style: italic;
}

/* Local section */
.outlet-card__local {
  margin-bottom: var(--space-8);
}

.outlet-card__local p {
  color: rgba(232, 224, 208, 0.75);
  line-height: 1.7;
  margin: 0;
}

.outlet-card__local code {
  font-family: 'JetBrains Mono', 'Fira Code', monospace;
  font-size: 0.9em;
  background: rgba(201, 162, 39, 0.12);
  color: var(--gold-300);
  border-radius: var(--radius-sm);
  padding: 2px 6px;
}

.outlet-card__local strong {
  color: rgba(232, 224, 208, 0.95);
}

/* CTA button */
.outlet-card__cta {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  font-size: var(--text-base);
  font-weight: 700;
  text-decoration: none;
}

/* Reddit card variants */
.outlet-card--reddit::before {
  background: linear-gradient(90deg, #FF4500, #FF6534, #FF4500);
}

.channel-tag--reddit {
  background: rgba(255, 69, 0, 0.12);
  color: #ff7a50;
  border-color: rgba(255, 69, 0, 0.3);
  font-family: inherit;
  font-weight: 600;
}

.outlet-card__channels--reddit {
  border-left: 3px solid rgba(255, 69, 0, 0.35);
}

.outlet-card__channels--reddit h3 {
  color: #ff7a50;
}

.outlet-card__cta--reddit {
  background: #FF4500;
  color: #fff;
  border: none;
  padding: var(--space-3) var(--space-6);
  border-radius: var(--radius-md);
  transition: background 0.2s ease, transform 0.15s ease;
}

.outlet-card__cta--reddit:hover {
  background: #e03d00;
  transform: translateY(-1px);
}

/* More outlets */
.more-outlets {
  background: linear-gradient(135deg, rgba(201,162,39,0.06), rgba(201,162,39,0.02));
  border: 1px dashed rgba(201, 162, 39, 0.2);
  border-radius: var(--radius-lg);
  padding: var(--space-8);
  margin-bottom: var(--space-10);
}

.more-outlets h2 {
  font-size: var(--text-xl);
  color: rgba(232, 224, 208, 0.7);
  margin: 0 0 var(--space-3) 0;
}

.more-outlets p {
  color: rgba(232, 224, 208, 0.55);
  line-height: 1.6;
  margin: 0;
  max-width: 65ch;
}

@media (max-width: 640px) {
  .outlet-card {
    padding: var(--space-6);
  }

  .outlet-card__header {
    gap: var(--space-4);
  }

  .outlet-card__name {
    font-size: var(--text-xl);
  }
}
</style>
