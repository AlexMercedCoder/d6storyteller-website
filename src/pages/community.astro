---
import BaseLayout from '../layouts/BaseLayout.astro';
import AmazonCTA from '../components/AmazonCTA.astro';
---

<BaseLayout
  title="D6 Storyteller Community | Connect, Share, and Play"
  description="Find your people: join the D6 Storyteller Slack community, build a local group, share homebrew settings and rules, and connect with Storytellers and players worldwide."
  canonicalUrl="https://d6storyteller.alexmerced.com/community/"
>
  <section class="section" aria-labelledby="community-heading">
    <div class="container container--narrow">
      <nav aria-label="Breadcrumb" class="breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__separator" aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Community</span>
      </nav>

      <p class="section-label">Find Your Table</p>
      <h1 id="community-heading">D6 Storyteller Community</h1>
      <p class="page-intro">
        D6 Storyteller works best when it gets played. This page lists the places where players,
        Storytellers, and creators gather to share campaigns, homebrew rules, setting ideas, and
        everything else that happens when a community builds around a game it cares about.
      </p>

      <!-- Slack -->
      <div class="outlet-card" id="slack-community">
        <div class="outlet-card__header">
          <div class="outlet-card__icon" aria-hidden="true">
            <svg width="32" height="32" viewBox="0 0 54 54" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M19.7 33.6c0 2.7-2.2 4.9-4.9 4.9s-4.9-2.2-4.9-4.9 2.2-4.9 4.9-4.9h4.9v4.9z" fill="#E01E5A"/>
              <path d="M22.2 33.6c0-2.7 2.2-4.9 4.9-4.9s4.9 2.2 4.9 4.9v12.3c0 2.7-2.2 4.9-4.9 4.9s-4.9-2.2-4.9-4.9V33.6z" fill="#E01E5A"/>
              <path d="M27.1 19.7c-2.7 0-4.9-2.2-4.9-4.9s2.2-4.9 4.9-4.9 4.9 2.2 4.9 4.9v4.9h-4.9z" fill="#36C5F0"/>
              <path d="M27.1 22.2c2.7 0 4.9 2.2 4.9 4.9s-2.2 4.9-4.9 4.9H14.8c-2.7 0-4.9-2.2-4.9-4.9s2.2-4.9 4.9-4.9h12.3z" fill="#36C5F0"/>
              <path d="M41 27.1c0-2.7 2.2-4.9 4.9-4.9s4.9 2.2 4.9 4.9-2.2 4.9-4.9 4.9H41v-4.9z" fill="#2EB67D"/>
              <path d="M38.5 27.1c0 2.7-2.2 4.9-4.9 4.9s-4.9-2.2-4.9-4.9V14.8c0-2.7 2.2-4.9 4.9-4.9s4.9 2.2 4.9 4.9v12.3z" fill="#2EB67D"/>
              <path d="M33.6 41c2.7 0 4.9 2.2 4.9 4.9s-2.2 4.9-4.9 4.9-4.9-2.2-4.9-4.9V41h4.9z" fill="#ECB22E"/>
              <path d="M33.6 38.5c-2.7 0-4.9-2.2-4.9-4.9s2.2-4.9 4.9-4.9h12.3c2.7 0 4.9 2.2 4.9 4.9s-2.2 4.9-4.9 4.9H33.6z" fill="#ECB22E"/>
            </svg>
          </div>
          <div class="outlet-card__title-block">
            <h2 class="outlet-card__name">D6 Storyteller Slack</h2>
            <span class="outlet-card__type">Official Community Hub</span>
          </div>
        </div>

        <p class="outlet-card__description">
          The D6 Storyteller Slack is the central gathering place for the community. Join to find
          players and Storytellers from around the world, share what you are running, get feedback
          on settings and homebrew, and connect with people who want to play.
        </p>

        <div class="outlet-card__channels">
          <h3>What to do when you join</h3>
          <ul class="channel-list">
            <li>
              <span class="channel-tag">#general</span>
              Introduce yourself and jump into the main conversation.
            </li>
            <li>
              <span class="channel-tag">#homebrew-workshop</span>
              Share your own settings, mechanics, and campaign ideas for feedback.
            </li>
            <li>
              <span class="channel-tag">#looking-for-group</span>
              Post when you are looking for players or a Storyteller for your next campaign.
            </li>
            <li>
              <span class="channel-tag">#resources</span>
              Share and discover community-made supplements, tools, and reference materials.
            </li>
          </ul>
        </div>

        <div class="outlet-card__local">
          <h3>Build a local channel</h3>
          <p>
            If you have a local gaming group or want to start one, create a city or region channel
            in the Slack - something like <code>#local-austin</code> or <code>#local-london</code>.
            Local channels are the best way to find people in your area for in-person sessions,
            one-shots, and conventions. Anyone in the workspace can create a channel: just use the
            <strong>+ Add Channel</strong> button in the sidebar.
          </p>
        </div>

        <a
          href="https://join.slack.com/t/d6storyteller-xnv2998/shared_invite/zt-45xlp464g-fZDcIpiP5cxqKXgJN8MqsA"
          class="outlet-card__cta btn btn--primary"
          target="_blank"
          rel="noopener noreferrer"
          id="slack-join-button"
        >
          Join the Slack Community
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>

      <!-- Placeholder for future outlets -->
      <div class="more-outlets">
        <h2>More community outlets coming</h2>
        <p>
          Additional community spaces - forums, Discord, and regional groups - will be added here
          as the community grows. If you run a D6 Storyteller community space and want it listed,
          reach out through the Slack.
        </p>
      </div>

      <AmazonCTA placement="community_bottom" variant="banner" />
    </div>
  </section>
</BaseLayout>

<style>
.page-intro {
  color: rgba(232, 224, 208, 0.75);
  margin-bottom: var(--space-10);
  max-width: 68ch;
  font-size: var(--text-lg);
  line-height: 1.7;
}

/* Outlet card */
.outlet-card {
  background: var(--navy-800);
  border: 1px solid rgba(201, 162, 39, 0.25);
  border-radius: var(--radius-lg);
  padding: var(--space-8);
  margin-bottom: var(--space-10);
  position: relative;
  overflow: hidden;
}

.outlet-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: linear-gradient(90deg, #E01E5A, #36C5F0, #2EB67D, #ECB22E);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
}

.outlet-card__header {
  display: flex;
  align-items: center;
  gap: var(--space-5);
  margin-bottom: var(--space-6);
}

.outlet-card__icon {
  background: rgba(255, 255, 255, 0.06);
  border-radius: var(--radius-md);
  padding: var(--space-3);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.outlet-card__name {
  font-size: var(--text-2xl);
  font-weight: 700;
  color: var(--gold-400);
  margin: 0 0 var(--space-1) 0;
}

.outlet-card__type {
  font-size: var(--text-sm);
  color: rgba(232, 224, 208, 0.5);
  font-weight: 500;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

.outlet-card__description {
  color: rgba(232, 224, 208, 0.8);
  line-height: 1.7;
  margin-bottom: var(--space-8);
  max-width: 70ch;
}

/* Channel list */
.outlet-card__channels {
  background: rgba(0, 0, 0, 0.25);
  border-radius: var(--radius-md);
  padding: var(--space-6);
  margin-bottom: var(--space-6);
}

.outlet-card__channels h3,
.outlet-card__local h3 {
  font-size: var(--text-base);
  font-weight: 700;
  color: var(--gold-300);
  margin: 0 0 var(--space-4) 0;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.channel-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.channel-list li {
  display: flex;
  align-items: baseline;
  gap: var(--space-3);
  color: rgba(232, 224, 208, 0.75);
  line-height: 1.5;
  flex-wrap: wrap;
}

.channel-tag {
  font-family: 'JetBrains Mono', 'Fira Code', monospace;
  font-size: var(--text-sm);
  background: rgba(201, 162, 39, 0.15);
  color: var(--gold-300);
  border: 1px solid rgba(201, 162, 39, 0.3);
  border-radius: var(--radius-sm);
  padding: 2px 8px;
  white-space: nowrap;
  flex-shrink: 0;
}

/* Local section */
.outlet-card__local {
  margin-bottom: var(--space-8);
}

.outlet-card__local p {
  color: rgba(232, 224, 208, 0.75);
  line-height: 1.7;
  margin: 0;
}

.outlet-card__local code {
  font-family: 'JetBrains Mono', 'Fira Code', monospace;
  font-size: 0.9em;
  background: rgba(201, 162, 39, 0.12);
  color: var(--gold-300);
  border-radius: var(--radius-sm);
  padding: 2px 6px;
}

.outlet-card__local strong {
  color: rgba(232, 224, 208, 0.95);
}

/* CTA button */
.outlet-card__cta {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  font-size: var(--text-base);
  font-weight: 700;
  text-decoration: none;
}

/* More outlets */
.more-outlets {
  background: linear-gradient(135deg, rgba(201,162,39,0.06), rgba(201,162,39,0.02));
  border: 1px dashed rgba(201, 162, 39, 0.2);
  border-radius: var(--radius-lg);
  padding: var(--space-8);
  margin-bottom: var(--space-10);
}

.more-outlets h2 {
  font-size: var(--text-xl);
  color: rgba(232, 224, 208, 0.7);
  margin: 0 0 var(--space-3) 0;
}

.more-outlets p {
  color: rgba(232, 224, 208, 0.55);
  line-height: 1.6;
  margin: 0;
  max-width: 65ch;
}

@media (max-width: 640px) {
  .outlet-card {
    padding: var(--space-6);
  }

  .outlet-card__header {
    gap: var(--space-4);
  }

  .outlet-card__name {
    font-size: var(--text-xl);
  }
}
</style>
