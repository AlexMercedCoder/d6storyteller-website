---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQ from '../components/FAQ.astro';
import AmazonCTA from '../components/AmazonCTA.astro';

const AMAZON_URL = 'https://www.amazon.com/dp/B0HC4XMKW3?binding=paperback&ref_=saga_sdp_cft_dsk';

const faqItems = [
  {
    question: 'What is D6 Storyteller?',
    answer: 'D6 Storyteller is a fiction-first tabletop roleplaying system created by Alex Merced. It resolves uncertain character actions using pools of standard six-sided dice, with narrative position and consequences driving play rather than complex modifiers or lookup tables.',
  },
  {
    question: 'Which book should I start with?',
    answer: 'Start with <strong>D6 Storyteller: The Core Rulebook</strong>. It contains the complete rules engine (character creation, dice mechanics, conflict resolution, harm, and the Storyteller guide) plus ten starter worlds covering multiple genres. Any companion can be added after your group is comfortable with the system.',
  },
  {
    question: 'Do I need the Core Rulebook to use a companion?',
    answer: 'Each companion contains a summary of the core mechanics sufficient to begin play, but the Core Rulebook provides the full rules reference and Storyteller guidance. Groups new to the D6 Storyteller system are strongly encouraged to begin with the Core Rulebook.',
  },
  {
    question: 'What dice are required?',
    answer: 'Only standard six-sided dice (d6): the kind found in almost any board game. The D6 Storyteller system uses no proprietary or unusual dice.',
  },
  {
    question: 'Is the game designed for players, Game Masters, or both?',
    answer: 'Both. D6 Storyteller uses the term <em>Storyteller</em> for the facilitating player. The Core Rulebook includes a full Storyteller guide alongside the player-facing rules. Every companion includes Storyteller guidance specific to its genre and settings.',
  },
  {
    question: 'Does each companion contain ten settings?',
    answer: 'Yes. Every companion volume contains ten complete, ready-to-play settings — each with world lore, a unique genre mechanic, three character archetypes, a condition palette, and a starter scenario.',
  },
  {
    question: 'Are character sheets included?',
    answer: 'Yes. Character sheets tailored to each setting are included in the companion volumes. Free printable sheets are also available at <a href="/downloads/">d6storyteller.alexmerced.com/downloads/</a>.',
  },
  {
    question: 'Can mechanics and settings be mixed between books?',
    answer: 'Yes. The D6 Storyteller engine is intentionally modular. Genre-specific mechanics from any companion can be imported into other settings or combined with lore from any other book in the series.',
  },
  {
    question: 'Where can I buy the books?',
    answer: 'The complete D6 Storyteller series is available on Amazon in paperback and Kindle formats. Visit the <a href="' + AMAZON_URL + '" target="_blank" rel="noopener noreferrer">Amazon series page</a> to browse all available titles.',
  },
  {
    question: 'Is D6 Storyteller available in paperback and Kindle formats?',
    answer: 'Yes. D6 Storyteller titles are available in both paperback and Kindle formats on Amazon. Availability of specific formats for each companion may vary.',
  },
  {
    question: 'What are Optional Mechanics?',
    answer: 'Optional Mechanics are modular add-on rules that any group can layer onto the core system — things like Wound Clocks, a Momentum Bank, Emotional Burden tracking, or Reputation Webs. None are required; each group chooses which ones fit their campaign. See the full list at <a href="/optional-mechanics/">Optional Mechanics</a>.',
  },
  {
    question: 'Are there free downloads for players?',
    answer: 'Yes — free printable character sheets, a Storyteller quick reference card, session planner, clocks & tracks sheet, and group roster are available at <a href="/downloads/">the Downloads page</a>. No account required.',
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "name": "D6 Storyteller FAQ",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer.replace(/<[^>]*>/g, '')
    }
  }))
};
---

<BaseLayout
  title="FAQ & About | D6 Storyteller"
  description="Frequently asked questions about D6 Storyteller — rules, dice, books, optional mechanics, and downloads — plus information about the system's creator, Alex Merced."
  canonicalUrl="https://d6storyteller.alexmerced.com/faq/"
  jsonLd={jsonLd}
>
  <section class="section" aria-labelledby="faq-about-heading">
    <div class="container">

      <nav aria-label="Breadcrumb" class="breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__separator" aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">FAQ & About</span>
      </nav>

      <!-- Page jump -->
      <div class="page-jump" role="navigation" aria-label="Page sections">
        <a href="#faq" class="page-jump__link">Frequently Asked Questions</a>
        <span aria-hidden="true">·</span>
        <a href="#about" class="page-jump__link">About the System & Creator</a>
        <span aria-hidden="true">·</span>
        <a href="#facts" class="page-jump__link">Verified Facts</a>
      </div>

      <!-- ── FAQ ── -->
      <div class="faq-section" id="faq">
        <p class="section-label">Questions & Answers</p>
        <h1 id="faq-about-heading">Frequently Asked Questions</h1>
        <p class="faq-intro">
          Questions about the D6 Storyteller system, books, dice, and where to buy.
        </p>
        <FAQ items={faqItems} />
      </div>

      <!-- ── About ── -->
      <div class="about-section" id="about">
        <p class="section-label">The System & Creator</p>
        <h2>About D6 Storyteller</h2>

        <div class="about-grid">
          <div class="about-block">
            <h3>What is D6 Storyteller?</h3>
            <p>
              D6 Storyteller is a fiction-first tabletop roleplaying system and book series created by Alex Merced. It uses pools of standard six-sided dice to resolve uncertain actions, with narrative position and consequence at the center of every roll. The system is built around the conviction that the story should drive the mechanics — not the other way around.
            </p>
            <p>
              The series consists of the Core Rulebook — the complete engine plus ten starter worlds — and a growing library of genre companion volumes, each containing ten fully realized settings with unique mechanics, archetypes, condition palettes, and starter scenarios.
            </p>
            <p>
              D6 Storyteller is available on Amazon in paperback and Kindle formats.
            </p>
          </div>

          <div class="about-block">
            <h3>About Alex Merced</h3>
            <p>
              <strong>Alex Merced</strong> is a developer, author, and tabletop game designer. He created the D6 Storyteller system as an expression of his approach to design: make the rules serve the story, keep complexity low and narrative possibility high, and ensure that any group can sit down and start playing in minutes.
            </p>
            <p>For more about Alex Merced's work, writing, and background:</p>
            <ul class="about-links">
              <li><a href="https://WhoIsAlexMerced.com" target="_blank" rel="noopener noreferrer">WhoIsAlexMerced.com ↗</a></li>
              <li><a href="https://books.alexmerced.com" target="_blank" rel="noopener noreferrer">books.alexmerced.com ↗</a></li>
            </ul>
          </div>
        </div>

        <div class="about-block about-block--full" style="margin-top:var(--space-6);">
          <h3>Editorial Ownership & Contact</h3>
          <p>
            All content on this website is produced and maintained by Alex Merced. Book descriptions, setting summaries, and system explanations are official author content. The D6 Storyteller system, all settings, and all fictional content are original creative works of Alex Merced (Copyright 2026).
          </p>
          <p>
            For permissions, licensing, or press inquiries, use the contact information available at <a href="https://WhoIsAlexMerced.com" target="_blank" rel="noopener noreferrer">WhoIsAlexMerced.com</a>.
          </p>
        </div>
      </div>

      <!-- ── Verified Facts ── -->
      <div class="facts-section" id="facts">
        <p class="section-label">For Reference</p>
        <h2>Verified Facts About the Series</h2>
        <div class="facts-grid">
          {[
            ['Name', 'D6 Storyteller'],
            ['Type', 'Fiction-first tabletop roleplaying system and book series'],
            ['Creator', 'Alex Merced'],
            ['Core resolution', 'Six-sided dice pools (d6 only)'],
            ['Core book', 'D6 Storyteller: The Core Rulebook'],
            ['Companion format', 'Ten themed settings per companion volume'],
            ['Optional Mechanics', '10 modular plug-in rules — see /optional-mechanics/'],
            ['Official site', 'https://d6storyteller.alexmerced.com/'],
            ['Purchase page', 'Amazon (link in site header)'],
          ].map(([label, value]) => (
            <div class="fact-row">
              <span class="fact-label">{label}</span>
              <span class="fact-value">{value}</span>
            </div>
          ))}
        </div>
      </div>

      <AmazonCTA placement="faq_about_bottom" variant="banner" label="Get the D6 Storyteller Series on Amazon" />
    </div>
  </section>
</BaseLayout>

<style>
/* Jump nav */
.page-jump {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  flex-wrap: wrap;
  margin-bottom: var(--space-10);
  font-size: var(--text-sm);
  color: rgba(232,224,208,0.35);
}
.page-jump__link {
  color: var(--gold-400);
  text-decoration: none;
  font-family: var(--font-heading);
  font-size: var(--text-xs);
  letter-spacing: 0.08em;
  text-transform: uppercase;
}
.page-jump__link:hover { color: var(--gold-300); text-shadow: none; }

/* FAQ section */
.faq-section {
  margin-bottom: var(--space-16);
  scroll-margin-top: 80px;
}
.faq-intro {
  color: rgba(232,224,208,0.7);
  max-width: 60ch;
  margin-bottom: var(--space-8);
}

/* About section */
.about-section {
  border-top: 1px solid rgba(201,162,39,0.2);
  padding-top: var(--space-12);
  margin-bottom: var(--space-12);
  scroll-margin-top: 80px;
}
.about-section h2 { margin-bottom: var(--space-8); }

.about-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-8);
}
@media (max-width: 700px) { .about-grid { grid-template-columns: 1fr; } }

.about-block h3 {
  font-size: var(--text-xl);
  color: var(--gold-300);
  margin-bottom: var(--space-4);
}
.about-block p {
  color: rgba(232,224,208,0.75);
  margin-bottom: var(--space-3);
  max-width: 60ch;
}
.about-block--full { grid-column: 1 / -1; }

.about-links {
  list-style: none;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  margin-top: var(--space-3);
}
.about-links li a {
  color: var(--gold-400);
  font-family: var(--font-heading);
  font-size: var(--text-sm);
  letter-spacing: 0.05em;
}
.about-links li a:hover { color: var(--gold-300); text-shadow: none; }

/* Facts section */
.facts-section {
  border-top: 1px solid rgba(201,162,39,0.2);
  padding-top: var(--space-12);
  margin-bottom: var(--space-10);
  scroll-margin-top: 80px;
}
.facts-section h2 { margin-bottom: var(--space-6); }
.facts-grid {
  display: flex;
  flex-direction: column;
  gap: 1px;
  background: rgba(201,162,39,0.12);
  border: 1px solid rgba(201,162,39,0.2);
  border-radius: var(--radius-md);
  overflow: hidden;
  max-width: 720px;
}
.fact-row {
  display: grid;
  grid-template-columns: 180px 1fr;
  background: var(--navy-900);
  gap: var(--space-4);
  padding: var(--space-3) var(--space-5);
}
@media (max-width: 500px) {
  .fact-row { grid-template-columns: 1fr; gap: var(--space-1); padding: var(--space-3); }
}
.fact-row:nth-child(even) { background: rgba(201,162,39,0.03); }
.fact-label {
  font-family: var(--font-heading);
  font-size: var(--text-xs);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--gold-400);
  padding-top: 2px;
  flex-shrink: 0;
}
.fact-value {
  font-size: var(--text-sm);
  color: rgba(232,224,208,0.8);
}
</style>
