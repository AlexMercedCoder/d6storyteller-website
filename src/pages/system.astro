---
import BaseLayout from '../layouts/BaseLayout.astro';
import AmazonCTA from '../components/AmazonCTA.astro';
import FAQ from '../components/FAQ.astro';

const faqItems = [
  {
    question: 'What does "fiction first" mean?',
    answer: 'Fiction first means that the narrative situation establishes the context before any dice are rolled. Your character\'s position — whether you\'re outnumbered, advantaged, under pressure, or operating with incomplete information — determines how many dice you roll and how much effect your action can have. The dice confirm the story; the fiction drives it.',
  },
  {
    question: 'How does the D6 dice pool work?',
    answer: 'You assemble a pool of six-sided dice based on your character\'s relevant approach and narrative position. Roll the pool and read the highest single die: 6 is a full success, 4–5 is a partial success with complication, 1–3 is a failure (though the story still moves forward). Multiple 6s can elevate the effect of a success.',
  },
  {
    question: 'Is D6 Storyteller beginner friendly?',
    answer: 'Yes. The system uses only standard six-sided dice you likely already own, has no complex lookup tables, and can put a new group at the table in under 15 minutes. The Core Rulebook includes a Storyteller\'s guide written specifically for people facilitating their first session.',
  },
  {
    question: 'What dice does D6 Storyteller use?',
    answer: 'Only standard six-sided dice (d6). No proprietary or unusual dice are required. Most households have several already.',
  },
  {
    question: 'Can settings from different books be combined?',
    answer: 'Yes. The D6 Storyteller engine is intentionally modular. Setting-specific mechanics from any companion can be imported into other worlds, and groups can mix lore and setting elements across books freely.',
  },
];
---

<BaseLayout
  title="How D6 Storyteller Works | Fiction-First D6 RPG"
  description="Learn how the D6 Storyteller system works — fiction-first narrative positioning, D6 dice pools, position and effect, characters, and genre mechanics. Beginner friendly. Six-sided dice only."
  canonicalUrl="https://d6storyteller.alexmerced.com/system/"
>
  <section class="section" aria-labelledby="system-heading">
    <div class="container container--narrow">
      <nav aria-label="Breadcrumb" class="breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__separator" aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">How It Works</span>
      </nav>

      <p class="section-label">The Engine</p>
      <h1 id="system-heading">How D6 Storyteller Works</h1>
      <p class="system-lead">
        D6 Storyteller is a fiction-first tabletop roleplaying engine that resolves uncertain actions with pools of six-sided dice.
      </p>

      <!-- What fiction first means -->
      <div class="system-section">
        <h2>What Does "Fiction First" Mean?</h2>
        <p>
          In most tabletop RPG systems, you choose an action and then look up which dice or modifiers apply. D6 Storyteller inverts this. Before any dice touch the table, the group establishes what is actually happening in the story: Where is your character? What are they attempting? What could go wrong? What could go right?
        </p>
        <p>
          This narrative context — what the system calls <em>position</em> — determines how many dice you roll. A character attempting something from a position of advantage rolls more dice. A character backed into a corner rolls fewer, or even just one. The fiction establishes the stakes. The dice confirm the outcome.
        </p>
      </div>

      <!-- D6 dice pools -->
      <div class="system-section">
        <h2>D6 Dice Pools</h2>
        <p>
          Characters in D6 Storyteller have four core approaches — <strong>Force</strong>, <strong>Finesse</strong>, <strong>Mind</strong>, and <strong>Presence</strong> — each rated in dice (typically 1d6 to 4d6). When a character acts, they pick the most relevant approach and assemble a pool of that many dice, adjusted up or down based on their narrative position.
        </p>
        <p>Roll the pool. Read the highest single die:</p>
        <div class="dice-results">
          <div class="dice-result dice-result--success">
            <span class="dice-result__value">6</span>
            <div>
              <strong>Full Success</strong>
              <p>You achieve what you set out to do. If you rolled multiple 6s, you may achieve it with Great Effect — doing more, faster, or with lasting impact.</p>
            </div>
          </div>
          <div class="dice-result dice-result--partial">
            <span class="dice-result__value">4–5</span>
            <div>
              <strong>Partial Success</strong>
              <p>You succeed, but at a cost: a complication, a partial outcome, or a consequence the Storyteller introduces. The story moves forward.</p>
            </div>
          </div>
          <div class="dice-result dice-result--fail">
            <span class="dice-result__value">1–3</span>
            <div>
              <strong>Failure with Consequence</strong>
              <p>You don't get what you wanted — and something worse happens. The story still moves. Failure is never a dead stop; it's a complication.</p>
            </div>
          </div>
        </div>
        <p>No modifiers are added to the dice. No arithmetic is required beyond counting dice and reading the highest face.</p>
      </div>

      <!-- Position, effect, consequences -->
      <div class="system-section">
        <h2>Position, Effect, and Narrative Stakes</h2>
        <p>
          Every action in D6 Storyteller is framed around two factors: <strong>position</strong> (how vulnerable is the character if things go wrong?) and <strong>effect</strong> (how much can the character actually accomplish if things go right?). A skilled warrior cornered in a burning room might have limited position but strong effect — they can hit hard, but the consequences of a partial success are severe. A novice negotiator with an ally's support might have better position than their approach would suggest.
        </p>
        <p>
          The Storyteller and players establish position and effect together before rolling, which creates a shared understanding of what the dice will actually mean — rather than leaving the interpretation to chance after the roll.
        </p>
      </div>

      <!-- Characters -->
      <div class="system-section">
        <h2>Characters and Archetypes</h2>
        <p>
          D6 Storyteller characters are defined by three elements: <strong>descriptors</strong> (evocative phrases that describe who you are and what you're good at), <strong>drives and flaws</strong> (motivations and vulnerabilities that make you interesting), and <strong>approach dice</strong> (Force, Finesse, Mind, Presence, distributed across 8 dice total).
        </p>
        <p>
          Every setting in the series includes three ready-to-play archetypes. These are not rigid classes — they're starting points. A group can take an archetype and play it immediately, or use it as a template to build something entirely their own. Character creation takes less than fifteen minutes.
        </p>
      </div>

      <!-- Genre mechanics -->
      <div class="system-section">
        <h2>Genre-Specific Mechanics</h2>
        <p>
          Each setting in the D6 Storyteller series includes one custom mechanic that captures the unique tension of its genre. These mechanics integrate directly with the core dice pool system rather than adding a separate rules layer. Examples include:
        </p>
        <ul class="mechanic-examples">
          <li><strong>Nagual Balance</strong> — shapeshifters track a meter between human sophistication and animal power, with each end offering different abilities at the cost of the other.</li>
          <li><strong>Sanity & Occult Clues</strong> — uncovering eldritch truths grants investigative advantages but permanently replaces approach dice with Insanity dice.</li>
          <li><strong>Broadside & Crew Morale</strong> — naval battles track ship hull integrity and crew morale clocks alongside personal combat.</li>
          <li><strong>Ki Charge & Ultimate Technique</strong> — building Ki across multiple rounds unlocks high-impact finishing moves with elevated effect.</li>
        </ul>
        <p>These mechanics are optional additions — groups can play any setting with the core engine alone or layer in the genre mechanic as desired.</p>
      </div>

      <!-- Core + companions -->
      <div class="system-section">
        <h2>The Core Rulebook and Companions</h2>
        <p>
          The <a href="/books/core-rulebook/">D6 Storyteller Core Rulebook</a> is the complete, self-contained foundation of the system. It contains everything a group needs: the full rules engine, character creation, conflict resolution, the Storyteller's guide, and ten starter worlds. No companion is required to play.
        </p>
        <p>
          Each companion expands the library of available worlds. Because the engine is genre-agnostic, companion mechanics and settings can be mixed freely across volumes. A campaign might begin in the high-fantasy setting of the Core Rulebook and later incorporate a mechanic from the Horror companion, or blend two companion settings into an entirely new world.
        </p>
      </div>

      <!-- What you need -->
      <div class="system-section">
        <h2>What Does a New Group Need to Begin?</h2>
        <ul>
          <li>The <a href="/books/core-rulebook/">D6 Storyteller Core Rulebook</a> (paperback or Kindle)</li>
          <li>A set of standard six-sided dice — four to six per player is comfortable, though fewer will work</li>
          <li>Index cards or paper for character notes</li>
          <li>Fifteen minutes for character creation</li>
          <li>A Storyteller willing to frame the first scene</li>
        </ul>
        <p>That's it. No miniatures, no battle maps, no additional books required.</p>
      </div>

      <div class="system-section">
        <h2>Common Questions About the System</h2>
        <FAQ items={faqItems} />
      </div>

      <div style="margin-top:var(--space-8);">
        <AmazonCTA placement="system_bottom" variant="banner" label="Get the Core Rulebook on Amazon" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
.system-lead {
  font-family: var(--font-heading);
  font-size: var(--text-xl);
  color: var(--gold-300);
  margin-bottom: var(--space-8);
  line-height: 1.4;
  max-width: 60ch;
}

.system-section {
  margin-bottom: var(--space-12);
}

.system-section h2 {
  font-size: var(--text-2xl);
  margin-bottom: var(--space-4);
  padding-bottom: var(--space-3);
  border-bottom: 1px solid rgba(201,162,39,0.15);
}

.system-section p { color: rgba(232,224,208,0.85); }

.dice-results {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  margin: var(--space-6) 0;
}

.dice-result {
  display: flex;
  align-items: flex-start;
  gap: var(--space-4);
  padding: var(--space-4);
  border-radius: var(--radius-md);
  border: 1px solid;
}

.dice-result--success { background: rgba(39,174,96,0.08); border-color: rgba(39,174,96,0.3); }
.dice-result--partial  { background: rgba(230,126,34,0.08); border-color: rgba(230,126,34,0.3); }
.dice-result--fail     { background: rgba(192,57,43,0.08);  border-color: rgba(192,57,43,0.3);  }

.dice-result__value {
  font-family: var(--font-display);
  font-size: var(--text-3xl);
  font-weight: 900;
  flex-shrink: 0;
  width: 3rem;
  text-align: center;
  line-height: 1;
}
.dice-result--success .dice-result__value { color: #27ae60; }
.dice-result--partial  .dice-result__value { color: #e67e22; }
.dice-result--fail     .dice-result__value { color: #c0392b; }

.dice-result strong { color: var(--gold-300); display: block; margin-bottom: var(--space-1); }
.dice-result p { font-size: var(--text-sm); color: rgba(232,224,208,0.7); margin: 0; }

.mechanic-examples { margin: var(--space-4) 0; }
.mechanic-examples li { margin-bottom: var(--space-3); color: rgba(232,224,208,0.8); }
.mechanic-examples strong { color: var(--gold-300); }
</style>
