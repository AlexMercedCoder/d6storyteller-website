  "Theme":           "rgba(120,80,200,0.15)",
  "Mystery":         "rgba(39,130,200,0.15)",
  "Investigation":   "rgba(39,130,200,0.15)",
  "History":         "rgba(180,140,50,0.15)",
  "Secrets":         "rgba(192,57,43,0.1)",
  "Factions":        "rgba(230,126,34,0.12)",
  "Politics":        "rgba(230,126,34,0.12)",
  "Conflict":        "rgba(192,57,43,0.1)",
  "Taboo":           "rgba(192,57,43,0.1)",
  "Stakes":          "rgba(192,57,43,0.1)",
