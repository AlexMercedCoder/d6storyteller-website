---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AmazonCTA from '../../components/AmazonCTA.astro';
import { getCollection } from 'astro:content';
import { optionalMechanics } from '../../data/optional-mechanics';

const settings = await getCollection('community-settings');
const allMechanicTags = [...new Set(optionalMechanics.flatMap(m => m.tags))].sort();
---

<BaseLayout
  title="Online Supplements | D6 Storyteller Additional Settings & Optional Mechanics"
  description="Explore official D6 Storyteller online supplements: additional fully designed settings with custom artwork, plus ten modular optional plug-in mechanics for any table."
  canonicalUrl="https://d6storyteller.alexmerced.com/supplements/"
>
  <section class="section" aria-labelledby="supplements-heading">
    <div class="container">
      <nav aria-label="Breadcrumb" class="breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__separator" aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Online Supplements</span>
      </nav>

      <p class="section-label">Expanded Universe & Rules</p>
      <h1 id="supplements-heading">Online Supplements</h1>
      <p class="supp-intro">
        Welcome to the official D6 Storyteller online supplements repository. Here you'll find <strong>Additional Settings</strong> (complete playable worlds featuring original artwork and mechanics) alongside <strong>Optional Plug-In Mechanics</strong> to customize your table.
      </p>

      <!-- Section Navigation Tabs -->
      <nav class="supp-tabs" aria-label="Supplements Section Navigation">
        <a href="#additional-settings" class="supp-tab supp-tab--active">
          <span aria-hidden="true">🌍</span> Additional Settings
        </a>
        <a href="#optional-mechanics" class="supp-tab">
          <span aria-hidden="true">⚙️</span> Optional Mechanics
        </a>
      </nav>

      <!-- SECTION 1: ADDITIONAL SETTINGS -->
      <section id="additional-settings" class="supp-section" aria-labelledby="add-settings-heading">
        <div class="supp-section__header">
          <h2 id="add-settings-heading">Additional Settings</h2>
          <p>
            Complete, ready-to-play worlds designed for the D6 Storyteller system. Each entry includes lore overview, unique genre mechanic, character archetypes, condition palette, and a starter scenario. Use the search bar or tag filters below to search by setting name or theme.
          </p>
        </div>

        <!-- Filter Controls Bar -->
        <div class="filter-controls card">
          <div class="filter-controls__inputs">
            <div class="filter-controls__field filter-controls__field--search">
              <label for="supp-search" class="filter-label">Search Settings</label>
              <div class="search-input-wrap">
                <span class="search-icon" aria-hidden="true">🔍</span>
                <input
                  type="text"
                  id="supp-search"
                  class="filter-input"
                  placeholder="Search by name, country, or folklore tag..."
                  aria-label="Search settings by name, country, or tag"
                />
                <button type="button" id="clear-supp-search" class="clear-btn hidden" aria-label="Clear search">✕</button>
              </div>
            </div>

            <div class="filter-controls__field filter-controls__field--select">
              <label for="supp-tag-select" class="filter-label">Filter by Tag</label>
              <select id="supp-tag-select" class="filter-select" aria-label="Filter by tag">
                <option value="">All Tags ({[...new Set(settings.flatMap(s => [s.data.genre, ...s.data.tags]))].length})</option>
                {[...new Set(settings.flatMap(s => [s.data.genre, ...s.data.tags]))].sort().map(tag => (
                  <option value={tag.toLowerCase()}>{tag}</option>
                ))}
              </select>
            </div>
          </div>

          <!-- Tag Pills -->
          <div class="tag-pills" id="supp-tag-pills">
            <span class="tag-pills__label">Quick Tags:</span>
            <button type="button" class="tag-pill tag-pill--active" data-tag="">All</button>
            {[...new Set(settings.flatMap(s => [s.data.genre, ...s.data.tags]))].sort().slice(0, 16).map(tag => (
              <button type="button" class="tag-pill" data-tag={tag.toLowerCase()}>{tag}</button>
            ))}
          </div>

          <div class="filter-summary">
            <span id="supp-results-count" class="results-count">Showing {settings.length} of {settings.length} settings</span>
            <button type="button" id="reset-supp-filters" class="btn btn--secondary btn--sm reset-btn hidden">Reset Filters</button>
          </div>
        </div>

        <div class="supp-grid" id="supp-grid">
          {settings.map(setting => (
            <article
              class="supp-card card"
              data-title={setting.data.title.toLowerCase()}
              data-tags={[setting.data.genre, ...setting.data.tags].map(t => t.toLowerCase()).join(',')}
              data-search-text={`${setting.data.title} ${setting.data.subtitle} ${setting.data.premise} ${setting.data.genre} ${setting.data.tags.join(' ')}`.toLowerCase()}
            >
              {setting.data.coverImage && (
                <div class="supp-card__image-wrap">
                  <img
                    src={setting.data.coverImage}
                    alt={setting.data.coverAlt || setting.data.title}
                    width="400"
                    height="400"
                    loading="lazy"
                    class="supp-card__cover"
                  />
                </div>
              )}
              <div class="supp-card__content">
                <div class="supp-card__tags">
                  <span class="tag tag--community" data-tag={setting.data.genre.toLowerCase()}>{setting.data.genre}</span>
                  {setting.data.tags.slice(0, 3).map(tag => (
                    <span class="tag tag--historical" style="font-size:0.65rem;" data-tag={tag.toLowerCase()}>{tag}</span>
                  ))}
                </div>
                <h3 class="supp-card__title">
                  <a href={`/community-settings/${setting.slug}/`}>{setting.data.title}</a>
                </h3>
                <p class="supp-card__subtitle">{setting.data.subtitle}</p>
                <p class="supp-card__premise">{setting.data.premise}</p>
                <p class="supp-card__mechanic">
                  <strong>Mechanic:</strong> {setting.data.mechanic}
                </p>
                <a href={`/community-settings/${setting.slug}/`} class="btn btn--primary supp-card__btn">
                  Read Full Setting →
                </a>
              </div>
            </article>
          ))}
        </div>

        <!-- No Results State -->
        <div id="supp-no-results" class="no-results card hidden">
          <div class="no-results__icon" aria-hidden="true">🗺️</div>
          <h3>No Settings Found</h3>
          <p>No setting matches your search term or tag filter. Try adjusting your search query or clear the filter.</p>
          <button type="button" id="supp-no-results-reset" class="btn btn--primary">Show All {settings.length} Settings</button>
        </div>

        <div class="supp-submit card">
          <h3>Submit a Supplemental Setting</h3>
          <p>
            Have you designed an original setting using the D6 Storyteller engine? Submit your setting for inclusion in the official online supplements. Contact Alex Merced at <a href="https://WhoIsAlexMerced.com" target="_blank" rel="noopener noreferrer">WhoIsAlexMerced.com</a>.
          </p>
        </div>
      </section>

      <!-- SECTION 2: OPTIONAL MECHANICS -->
      <section id="optional-mechanics" class="supp-section" aria-labelledby="opt-mechanics-heading">
        <div class="supp-section__header">
          <h2 id="opt-mechanics-heading">Optional Plug-In Mechanics ({optionalMechanics.length})</h2>
          <p>
            Fifty modular rules additions you can drop into any campaign, regardless of setting or genre. Use the ones that fit your table; ignore the rest. Search by name, keyword, or tag below.
          </p>
        </div>

        <!-- Filter Controls Bar for Mechanics -->
        <div class="filter-controls card">
          <div class="filter-controls__inputs">
            <div class="filter-controls__field filter-controls__field--search">
              <label for="om-search" class="filter-label">Search Mechanics</label>
              <div class="search-input-wrap">
                <span class="search-icon" aria-hidden="true">🔍</span>
                <input
                  type="text"
                  id="om-search"
                  class="filter-input"
                  placeholder="Search by mechanic name, effect, or keyword..."
                  aria-label="Search optional mechanics by name or keyword"
                />
                <button type="button" id="clear-om-search" class="clear-btn hidden" aria-label="Clear search">✕</button>
              </div>
            </div>

            <div class="filter-controls__field filter-controls__field--select">
              <label for="om-tag-select" class="filter-label">Filter by Tag</label>
              <select id="om-tag-select" class="filter-select" aria-label="Filter mechanics by tag">
                <option value="">All Tags ({allMechanicTags.length})</option>
                {allMechanicTags.map(tag => (
                  <option value={tag.toLowerCase()}>{tag}</option>
                ))}
              </select>
            </div>
          </div>

          <!-- Tag Pills for Mechanics -->
          <div class="tag-pills" id="om-tag-pills">
            <span class="tag-pills__label">Quick Tags:</span>
            <button type="button" class="tag-pill tag-pill--active" data-om-tag="">All</button>
            {allMechanicTags.slice(0, 18).map(tag => (
              <button type="button" class="tag-pill" data-om-tag={tag.toLowerCase()}>{tag}</button>
            ))}
          </div>

          <div class="filter-summary">
            <span id="om-results-count" class="results-count">Showing {optionalMechanics.length} of {optionalMechanics.length} mechanics</span>
            <button type="button" id="reset-om-filters" class="btn btn--secondary btn--sm reset-btn hidden">Reset Filters</button>
          </div>
        </div>

        <!-- Quick Jump Links -->
        <div class="om-quicknav">
          <span class="om-quicknav__label">Jump to Mechanic:</span>
          <div class="om-quicknav__links">
            {optionalMechanics.map(m => (
              <a href={`#${m.id}`} class="om-quicknav__link">{m.name}</a>
            ))}
          </div>
        </div>

        <div class="om-list" id="om-list">
          {optionalMechanics.map((mechanic, i) => (
            <article
              class="om-card card"
              id={mechanic.id}
              data-name={mechanic.name.toLowerCase()}
              data-tags={mechanic.tags.map(t => t.toLowerCase()).join(',')}
              data-search-text={`${mechanic.name} ${mechanic.tagline} ${mechanic.summary} ${mechanic.description} ${mechanic.whenToUse} ${mechanic.example} ${mechanic.tags.join(' ')}`.toLowerCase()}
            >
              <header class="om-card__header">
                <div class="om-card__number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</div>
                <div class="om-card__title-block">
                  <h3 class="om-card__name">{mechanic.name}</h3>
                  <p class="om-card__tagline">"{mechanic.tagline}"</p>
                </div>
                <div class="om-card__tags">
                  {mechanic.tags.map(tag => (
                    <span class="tag tag--community" style="font-size:0.65rem;" data-om-tag={tag.toLowerCase()}>{tag}</span>
                  ))}
                </div>
              </header>

              <p class="om-card__summary">{mechanic.summary}</p>

              <div class="om-card__body">
                <div class="om-card__section">
                  <h4 class="om-card__section-label">How It Works</h4>
                  <p class="om-card__text">{mechanic.description}</p>
                </div>

                <div class="om-card__section">
                  <h4 class="om-card__section-label">When to Use It</h4>
                  <p class="om-card__text om-card__text--muted">{mechanic.whenToUse}</p>
                </div>

                <div class="om-card__example">
                  <h4 class="om-card__section-label">Example</h4>
                  <blockquote class="om-card__quote">{mechanic.example}</blockquote>
                </div>
              </div>
            </article>
          ))}
        </div>

        <!-- No Results State for Mechanics -->
        <div id="om-no-results" class="no-results card hidden">
          <div class="no-results__icon" aria-hidden="true">⚙️</div>
          <h3>No Mechanics Found</h3>
          <p>No mechanic matches your search term or tag filter. Try adjusting your search query or reset the filter.</p>
          <button type="button" id="om-no-results-reset" class="btn btn--primary">Show All {optionalMechanics.length} Mechanics</button>
        </div>
      </section>

      <div style="margin-top:var(--space-10);">
        <AmazonCTA placement="supplements_bottom" variant="banner" label="Get the D6 Storyteller Core Rulebook on Amazon" />
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // -------------------------------------------------------------
    // 1. ADDITIONAL SETTINGS SEARCH & FILTER
    // -------------------------------------------------------------
    const searchInput = document.getElementById('supp-search') as HTMLInputElement | null;
    const tagSelect = document.getElementById('supp-tag-select') as HTMLSelectElement | null;
    const clearSearchBtn = document.getElementById('clear-supp-search') as HTMLButtonElement | null;
    const resetFiltersBtn = document.getElementById('reset-supp-filters') as HTMLButtonElement | null;
    const noResultsResetBtn = document.getElementById('supp-no-results-reset') as HTMLButtonElement | null;
    const resultsCount = document.getElementById('supp-results-count');
    const noResults = document.getElementById('supp-no-results');
    const suppGrid = document.getElementById('supp-grid');
    const tagPillsContainer = document.getElementById('supp-tag-pills');

    if (suppGrid) {
      const cards = Array.from(suppGrid.querySelectorAll('.supp-card')) as HTMLElement[];
      const totalCount = cards.length;

      let currentQuery = '';
      let currentTag = '';

      function filterSupplements() {
        let visibleCount = 0;

        cards.forEach(card => {
          const searchText = card.getAttribute('data-search-text') || '';
          const cardTags = (card.getAttribute('data-tags') || '').split(',');

          const matchesQuery = !currentQuery || searchText.includes(currentQuery.toLowerCase().trim());
          const matchesTag = !currentTag || cardTags.includes(currentTag.toLowerCase());

          if (matchesQuery && matchesTag) {
            card.style.display = '';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        if (resultsCount) {
          resultsCount.textContent = `Showing ${visibleCount} of ${totalCount} settings`;
        }

        if (noResults) {
          if (visibleCount === 0) {
            noResults.classList.remove('hidden');
            suppGrid.style.display = 'none';
          } else {
            noResults.classList.add('hidden');
            suppGrid.style.display = 'grid';
          }
        }

        if (clearSearchBtn) {
          if (currentQuery) {
            clearSearchBtn.classList.remove('hidden');
          } else {
            clearSearchBtn.classList.add('hidden');
          }
        }

        if (resetFiltersBtn) {
          if (currentQuery || currentTag) {
            resetFiltersBtn.classList.remove('hidden');
          } else {
            resetFiltersBtn.classList.add('hidden');
          }
        }

        if (tagPillsContainer) {
          const pills = tagPillsContainer.querySelectorAll('.tag-pill');
          pills.forEach(pill => {
            const pillTag = pill.getAttribute('data-tag') || '';
            if (pillTag === currentTag) {
              pill.classList.add('tag-pill--active');
            } else {
              pill.classList.remove('tag-pill--active');
            }
          });
        }

        if (tagSelect && tagSelect.value !== currentTag) {
          tagSelect.value = currentTag;
        }
      }

      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          currentQuery = (e.target as HTMLInputElement).value;
          filterSupplements();
        });
      }

      if (tagSelect) {
        tagSelect.addEventListener('change', (e) => {
          currentTag = (e.target as HTMLSelectElement).value;
          filterSupplements();
        });
      }

      if (tagPillsContainer) {
        tagPillsContainer.addEventListener('click', (e) => {
          const target = e.target as HTMLElement;
          if (target.classList.contains('tag-pill')) {
            currentTag = target.getAttribute('data-tag') || '';
            filterSupplements();
          }
        });
      }

      suppGrid.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target.hasAttribute('data-tag')) {
          const tag = target.getAttribute('data-tag') || '';
          currentTag = tag;
          filterSupplements();
        }
      });

      if (clearSearchBtn) {
        clearSearchBtn.addEventListener('click', () => {
          if (searchInput) searchInput.value = '';
          currentQuery = '';
          filterSupplements();
          if (searchInput) searchInput.focus();
        });
      }

      function resetAllSupplements() {
        if (searchInput) searchInput.value = '';
        currentQuery = '';
        currentTag = '';
        if (tagSelect) tagSelect.value = '';
        filterSupplements();
      }

      if (resetFiltersBtn) resetFiltersBtn.addEventListener('click', resetAllSupplements);
      if (noResultsResetBtn) noResultsResetBtn.addEventListener('click', resetAllSupplements);
    }

    // -------------------------------------------------------------
    // 2. OPTIONAL MECHANICS SEARCH & FILTER
    // -------------------------------------------------------------
    const omSearchInput = document.getElementById('om-search') as HTMLInputElement | null;
    const omTagSelect = document.getElementById('om-tag-select') as HTMLSelectElement | null;
    const omClearSearchBtn = document.getElementById('clear-om-search') as HTMLButtonElement | null;
    const omResetFiltersBtn = document.getElementById('reset-om-filters') as HTMLButtonElement | null;
    const omNoResultsResetBtn = document.getElementById('om-no-results-reset') as HTMLButtonElement | null;
    const omResultsCount = document.getElementById('om-results-count');
    const omNoResults = document.getElementById('om-no-results');
    const omList = document.getElementById('om-list');
    const omTagPillsContainer = document.getElementById('om-tag-pills');

    if (omList) {
      const omCards = Array.from(omList.querySelectorAll('.om-card')) as HTMLElement[];
      const omTotalCount = omCards.length;

      let omQuery = '';
      let omTag = '';

      function filterMechanics() {
        let visibleCount = 0;

        omCards.forEach(card => {
          const searchText = card.getAttribute('data-search-text') || '';
          const cardTags = (card.getAttribute('data-tags') || '').split(',');

          const matchesQuery = !omQuery || searchText.includes(omQuery.toLowerCase().trim());
          const matchesTag = !omTag || cardTags.includes(omTag.toLowerCase());

          if (matchesQuery && matchesTag) {
            card.style.display = '';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        if (omResultsCount) {
          omResultsCount.textContent = `Showing ${visibleCount} of ${omTotalCount} mechanics`;
        }

        if (omNoResults) {
          if (visibleCount === 0) {
            omNoResults.classList.remove('hidden');
            omList.style.display = 'none';
          } else {
            omNoResults.classList.add('hidden');
            omList.style.display = 'flex';
          }
        }

        if (omClearSearchBtn) {
          if (omQuery) {
            omClearSearchBtn.classList.remove('hidden');
          } else {
            omClearSearchBtn.classList.add('hidden');
          }
        }

        if (omResetFiltersBtn) {
          if (omQuery || omTag) {
            omResetFiltersBtn.classList.remove('hidden');
          } else {
            omResetFiltersBtn.classList.add('hidden');
          }
        }

        if (omTagPillsContainer) {
          const pills = omTagPillsContainer.querySelectorAll('.tag-pill');
          pills.forEach(pill => {
            const pillTag = pill.getAttribute('data-om-tag') || '';
            if (pillTag === omTag) {
              pill.classList.add('tag-pill--active');
            } else {
              pill.classList.remove('tag-pill--active');
            }
          });
        }

        if (omTagSelect && omTagSelect.value !== omTag) {
          omTagSelect.value = omTag;
        }
      }

      if (omSearchInput) {
        omSearchInput.addEventListener('input', (e) => {
          omQuery = (e.target as HTMLInputElement).value;
          filterMechanics();
        });
      }

      if (omTagSelect) {
        omTagSelect.addEventListener('change', (e) => {
          omTag = (e.target as HTMLSelectElement).value;
          filterMechanics();
        });
      }

      if (omTagPillsContainer) {
        omTagPillsContainer.addEventListener('click', (e) => {
          const target = e.target as HTMLElement;
          if (target.classList.contains('tag-pill')) {
            omTag = target.getAttribute('data-om-tag') || '';
            filterMechanics();
          }
        });
      }

      omList.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target.hasAttribute('data-om-tag')) {
          const tag = target.getAttribute('data-om-tag') || '';
          omTag = tag;
          filterMechanics();
        }
      });

      if (omClearSearchBtn) {
        omClearSearchBtn.addEventListener('click', () => {
          if (omSearchInput) omSearchInput.value = '';
          omQuery = '';
          filterMechanics();
          if (omSearchInput) omSearchInput.focus();
        });
      }

      function resetAllMechanics() {
        if (omSearchInput) omSearchInput.value = '';
        omQuery = '';
        omTag = '';
        if (omTagSelect) omTagSelect.value = '';
        filterMechanics();
      }

      if (omResetFiltersBtn) omResetFiltersBtn.addEventListener('click', resetAllMechanics);
      if (omNoResultsResetBtn) omNoResultsResetBtn.addEventListener('click', resetAllMechanics);
    }
  });
</script>

<style>
.supp-intro {
  max-width: 70ch;
  font-size: var(--text-lg);
  color: rgba(232, 224, 208, 0.85);
  margin-bottom: var(--space-8);
  line-height: 1.6;
}

/* Tabs */
.supp-tabs {
  display: flex;
  gap: var(--space-3);
  margin-bottom: var(--space-10);
  border-bottom: 1px solid rgba(201, 162, 39, 0.2);
  padding-bottom: var(--space-4);
}

.supp-tab {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  font-family: var(--font-heading);
  font-size: var(--text-base);
  font-weight: 600;
  color: rgba(232, 224, 208, 0.7);
  text-decoration: none;
  padding: var(--space-3) var(--space-5);
  border-radius: var(--radius-md);
  background: var(--navy-900);
  border: 1px solid rgba(201, 162, 39, 0.15);
  transition: all var(--transition-fast);
}

.supp-tab:hover,
.supp-tab--active {
  color: var(--gold-300);
  background: rgba(201, 162, 39, 0.1);
  border-color: var(--gold-400);
  text-shadow: none;
}

/* Section styling */
.supp-section {
  margin-bottom: var(--space-16);
  scroll-margin-top: 80px;
}

.supp-section__header {
  margin-bottom: var(--space-8);
  padding-bottom: var(--space-4);
  border-bottom: 1px solid rgba(201, 162, 39, 0.2);
}

.supp-section__header h2 {
  font-size: var(--text-3xl);
  color: var(--gold-300);
  margin-bottom: var(--space-2);
}

.supp-section__header p {
  color: rgba(232, 224, 208, 0.75);
  max-width: 68ch;
  margin: 0;
}

/* Settings Grid */
.supp-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
  gap: var(--space-8);
  margin-bottom: var(--space-8);
}

.supp-card {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding: 0;
}

.supp-card__image-wrap {
  width: 100%;
  aspect-ratio: 16 / 9;
  overflow: hidden;
  background: var(--navy-950);
}

.supp-card__cover {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform var(--transition-base);
}

.supp-card:hover .supp-card__cover {
  transform: scale(1.03);
}

.supp-card__content {
  padding: var(--space-6);
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  flex-grow: 1;
}

.supp-card__tags { display: flex; flex-wrap: wrap; gap: var(--space-2); }

.supp-card__title {
  font-size: var(--text-2xl);
  margin: 0;
  line-height: 1.2;
}

.supp-card__title a {
  color: var(--gold-300);
  text-decoration: none;
}

.supp-card__subtitle {
  font-family: var(--font-heading);
  font-size: var(--text-sm);
  font-style: italic;
  color: rgba(232, 224, 208, 0.55);
  margin: 0;
}

.supp-card__premise {
  font-size: var(--text-sm);
  color: rgba(232, 224, 208, 0.8);
  margin: 0;
  line-height: 1.6;
}

.supp-card__mechanic {
  font-size: var(--text-xs);
  color: rgba(232, 224, 208, 0.6);
  margin: 0;
}
.supp-card__mechanic strong { color: var(--gold-400); }

.supp-card__btn {
  margin-top: auto;
  align-self: flex-start;
  font-size: var(--text-sm);
}

.supp-submit {
