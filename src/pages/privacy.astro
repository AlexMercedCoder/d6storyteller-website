---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Privacy Policy | D6 Storyteller"
  description="Privacy policy for d6storyteller.alexmerced.com: information about analytics, cookies, and data practices."
  canonicalUrl="https://d6storyteller.alexmerced.com/privacy/"
>
  <section class="section" aria-labelledby="privacy-heading">
    <div class="container container--narrow">
      <p class="section-label">Legal</p>
      <h1 id="privacy-heading">Privacy Policy</h1>
      <p style="color:rgba(232,224,208,0.6);margin-bottom:var(--space-8);">Last updated: July 2026</p>

      <div class="privacy-section">
        <h2>Overview</h2>
        <p>d6storyteller.alexmerced.com is a marketing website for the D6 Storyteller tabletop RPG series. This site does not process payments, create user accounts, or collect personal information for any purpose other than the analytics described below.</p>
      </div>

      <div class="privacy-section">
        <h2>Analytics</h2>
        <p>This site may use privacy-conscious web analytics to understand traffic patterns, popular content, and outbound clicks to Amazon. Analytics data is used solely to improve the site's content and user experience. No analytics data is sold or shared with third parties for advertising purposes.</p>
      </div>

      <div class="privacy-section">
        <h2>External Links</h2>
        <p>This site links to Amazon for book purchases. Amazon is an independent third party and its privacy practices are governed by <a href="https://www.amazon.com/gp/help/customer/display.html?nodeId=468496" target="_blank" rel="noopener noreferrer">Amazon's Privacy Notice</a>. This site has no affiliate or paid relationship with Amazon unless explicitly noted.</p>
      </div>

      <div class="privacy-section">
        <h2>Contact</h2>
        <p>For questions about privacy practices, contact Alex Merced through <a href="https://WhoIsAlexMerced.com" target="_blank" rel="noopener noreferrer">WhoIsAlexMerced.com</a>.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
.privacy-section { margin-bottom: var(--space-8); }
.privacy-section h2 { margin-bottom: var(--space-4); font-size: var(--text-xl); }
</style>
